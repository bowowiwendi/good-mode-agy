#!/data/data/com.termux/files/usr/bin/bash
# ==============================================================================
# 🚀 GMA (Good Mode AGY) - v1.2.0
# Multi-Account Manager, Auto-Switcher & Enhancer for Antigravity CLI on Termux
# ==============================================================================
set -euo pipefail

VERSION="1.2.0"
APP_NAME="GMA (Good Mode AGY)"

# ANSI Colors
if [[ "${1:-}" != "--no-color" && -t 1 ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    BLUE='\033[0;34m'
    MAGENTA='\033[0;35m'
    CYAN='\033[0;36m'
    BOLD='\033[1m'
    NC='\033[0m'
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    MAGENTA=''
    CYAN=''
    BOLD=''
    NC=''
fi

# Flag processing for --no-color
if [[ "${1:-}" == "--no-color" ]]; then
    shift
fi

# Base paths
HOME_DIR="${HOME:-/data/data/com.termux/files/home}"
GEMINI_DIR="$HOME_DIR/.gemini"
AGY_CLI_DIR="$GEMINI_DIR/antigravity-cli"
ACCOUNTS_DIR="$GEMINI_DIR/accounts"

# Target files
TOKEN_FILE="$AGY_CLI_DIR/antigravity-oauth-token"
CRED_FILE="$GEMINI_DIR/gemini-credentials.json"
GOOGLE_ACC_FILE="$GEMINI_DIR/google_accounts.json"
SETTINGS_FILE="$AGY_CLI_DIR/settings.json"

mkdir -p "$ACCOUNTS_DIR"

# ------------------------------------------------------------------------------
# Helper: Termux & Terminal Notifications
# ------------------------------------------------------------------------------
send_termux_notification() {
    local title="$1"
    local content="$2"
    local priority="${3:-high}"

    # 1. Termux API notification if installed
    if command -v termux-notification &>/dev/null; then
        termux-notification \
            --title "$title" \
            --content "$content" \
            --id "gma_notify" \
            --priority "$priority" \
            --icon "sync" 2>/dev/null || true
    fi

    # 2. Termux Toast if installed
    if command -v termux-toast &>/dev/null; then
        termux-toast "$title: $content" 2>/dev/null || true
    fi

    # 3. Terminal Notification Escape sequences (OSC 9 & OSC 777) & Bell
    printf '\e]9;%s: %s\a' "$title" "$content" 2>/dev/null || true
    printf '\a' 2>/dev/null || true
}

# ------------------------------------------------------------------------------
# Helper: Locate working agy binary
# ------------------------------------------------------------------------------
get_agy_binary() {
    local candidates=()
    local sys_agy
    sys_agy=$(command -v agy 2>/dev/null || true)
    [[ -n "$sys_agy" ]] && candidates+=("$sys_agy")
    [[ -n "${PREFIX:-}" && -x "$PREFIX/bin/agy" ]] && candidates+=("$PREFIX/bin/agy")
    candidates+=(
        "/data/data/com.termux/files/usr/bin/agy"
        "$HOME/.local/bin/agy"
    )

    for candidate in "${candidates[@]}"; do
        if [[ -x "$candidate" ]]; then
            if "$candidate" --help >/dev/null 2>&1; then
                echo "$candidate"
                return 0
            fi
        fi
    done
    return 1
}

# ------------------------------------------------------------------------------
# Helper: Decode JWT Email
# ------------------------------------------------------------------------------
decode_jwt_email() {
    local token="$1"
    local payload
    payload=$(echo "$token" | cut -d'.' -f2)
    local len=$((${#payload} % 4))
    if [ $len -eq 2 ]; then payload="${payload}=="; fi
    if [ $len -eq 3 ]; then payload="${payload}="; fi
    echo "$payload" | base64 -d 2>/dev/null | grep -oP '"email"\s*:\s*"\K[^"]+' || echo "unknown"
}

# ------------------------------------------------------------------------------
# Helper: Get current email
# ------------------------------------------------------------------------------
get_current_email() {
    if [[ -f "$TOKEN_FILE" ]]; then
        if command -v python3 &>/dev/null; then
            local email
            email=$(python3 -c "
import json, base64, sys
try:
    with open('$TOKEN_FILE') as f:
        data = json.load(f)
    id_tok = data.get('id_token', '')
    if id_tok:
        payload = id_tok.split('.')[1]
        payload += '=' * ((4 - len(payload) % 4) % 4)
        dec = json.loads(base64.urlsafe_b64decode(payload.encode()).decode('utf-8', errors='ignore'))
        print(dec.get('email', 'unknown'))
    else:
        print('unknown')
except Exception:
    print('unknown')
" 2>/dev/null || true)
            if [[ -n "$email" && "$email" != "unknown" ]]; then
                echo "$email"
                return
            fi
        fi

        # Fallback to pure bash grep
        local id_token
        id_token=$(grep -oP '"id_token"\s*:\s*"\K[^"]+' "$TOKEN_FILE" 2>/dev/null || true)
        if [[ -n "$id_token" ]]; then
            decode_jwt_email "$id_token"
        else
            echo "unknown"
        fi
    else
        echo "none"
    fi
}

sanitize_email() {
    echo "$1" | sed 's/[^a-zA-Z0-9.-]/_/g'
}

# ------------------------------------------------------------------------------
# Helper: Get all saved accounts as an array
# Output format per line: email|dir|alias|model|auto_rotate
# ------------------------------------------------------------------------------
get_saved_accounts() {
    if [[ ! -d "$ACCOUNTS_DIR" ]]; then
        return
    fi

    if command -v python3 &>/dev/null; then
        python3 -c "
import os, json, sys

accounts_dir = '$ACCOUNTS_DIR'
items = []
if os.path.exists(accounts_dir):
    for name in os.listdir(accounts_dir):
        dir_path = os.path.join(accounts_dir, name)
        if os.path.isdir(dir_path):
            meta_path = os.path.join(dir_path, 'meta.json')
            email, alias, model, auto_rotate = 'unknown', '', '', 'true'
            if os.path.exists(meta_path):
                try:
                    with open(meta_path) as f:
                        meta = json.load(f)
                    email = meta.get('email', 'unknown')
                    alias = meta.get('alias', '')
                    model = meta.get('model', '')
                    auto_rotate = 'true' if meta.get('auto_rotate', True) else 'false'
                except Exception:
                    pass
            if email != 'unknown':
                items.append((email, dir_path, alias, model, auto_rotate))

items.sort(key=lambda x: x[0])
for email, dir_path, alias, model, auto_rotate in items:
    print(f'{email}|{dir_path}|{alias}|{model}|{auto_rotate}')
" 2>/dev/null || true
    else
        # Pure bash fallback
        for dir in "$ACCOUNTS_DIR"/*; do
            if [[ -d "$dir" ]]; then
                local meta_email="unknown"
                local alias=""
                local model=""
                local auto_rotate="true"
                if [[ -f "$dir/meta.json" ]]; then
                    meta_email=$(grep -oP '"email"\s*:\s*"\K[^"]+' "$dir/meta.json" 2>/dev/null || echo "unknown")
                    alias=$(grep -oP '"alias"\s*:\s*"\K[^"]+' "$dir/meta.json" 2>/dev/null || true)
                    model=$(grep -oP '"model"\s*:\s*"\K[^"]+' "$dir/meta.json" 2>/dev/null || true)
                fi
                if [[ "$meta_email" != "unknown" ]]; then
                    echo "$meta_email|$dir|$alias|$model|$auto_rotate"
                fi
            fi
        done | sort
    fi
}

# ------------------------------------------------------------------------------
# Helper: Read account metadata
# ------------------------------------------------------------------------------
get_account_meta() {
    local target_email="$1"
    local safe_email
    safe_email=$(sanitize_email "$target_email")
    local meta_path="$ACCOUNTS_DIR/$safe_email/meta.json"
    if [[ -f "$meta_path" ]] && command -v python3 &>/dev/null; then
        python3 -c "
import json
with open('$meta_path') as f:
    d = json.load(f)
print(f\"{d.get('alias','')}|{d.get('model','')}|{d.get('effort','')}|{d.get('auto_rotate', True)}|{d.get('notes','')}\")
" 2>/dev/null || echo "|||True|"
    else
        echo "|||True|"
    fi
}

# ------------------------------------------------------------------------------
# Helper: Save account metadata
# ------------------------------------------------------------------------------
update_account_meta() {
    local target_email="$1"
    local key="$2"
    local value="$3"
    local safe_email
    safe_email=$(sanitize_email "$target_email")
    local prof_dir="$ACCOUNTS_DIR/$safe_email"
    mkdir -p "$prof_dir"
    local meta_path="$prof_dir/meta.json"

    if command -v python3 &>/dev/null; then
        python3 -c "
import json, os, datetime

meta_path = '$meta_path'
data = {'email': '$target_email'}
if os.path.exists(meta_path):
    try:
        with open(meta_path) as f:
            data = json.load(f)
    except Exception:
        pass

val = '$value'
if '$key' == 'auto_rotate':
    data['$key'] = (val.lower() in ('true', '1', 'yes', 'on'))
else:
    data['$key'] = val

data['updated_at'] = datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')

with open(meta_path, 'w') as f:
    json.dump(data, f, indent=2)
"
    fi
}

# ------------------------------------------------------------------------------
# Command: list
# ------------------------------------------------------------------------------
list_accounts() {
    local current
    current=$(get_current_email)
    echo -e "${BLUE}=== 🚀 ${APP_NAME} v${VERSION} - Accounts ===${NC}"
    
    local accounts=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && accounts+=("$line")
    done < <(get_saved_accounts)

    if [[ ${#accounts[@]} -eq 0 ]]; then
        echo -e "${YELLOW}Belum ada akun yang tersimpan.${NC}"
        echo "Gunakan 'gma save' untuk menyimpan akun aktif, atau 'gma add' untuk menambah akun baru."
    else
        local idx=1
        for acc in "${accounts[@]}"; do
            local email
            local alias
            local model
            local auto_rot
            email=$(echo "$acc" | cut -d'|' -f1)
            alias=$(echo "$acc" | cut -d'|' -f3)
            model=$(echo "$acc" | cut -d'|' -f4)
            auto_rot=$(echo "$acc" | cut -d'|' -f5)

            local marker="  "
            if [[ "$email" == "$current" && "$current" != "none" ]]; then
                marker="${GREEN}* ${NC}"
            fi

            local alias_str=""
            if [[ -n "$alias" ]]; then
                alias_str=" ${MAGENTA}[${alias}]${NC}"
            fi

            local model_str=""
            if [[ -n "$model" ]]; then
                model_str=" ${CYAN}(${model})${NC}"
            fi

            local rot_str=""
            if [[ "$auto_rot" == "false" ]]; then
                rot_str=" ${YELLOW}[No-Rotate]${NC}"
            fi

            echo -e "${marker}${BOLD}${idx}.${NC} ${email}${alias_str}${model_str}${rot_str}"
            idx=$((idx + 1))
        done
    fi
    
    echo ""
    if [[ "$current" == "none" ]]; then
        echo -e "${YELLOW}Status: Tidak ada akun yang aktif saat ini.${NC}"
    else
        local found=0
        for acc in "${accounts[@]}"; do
            if [[ "${acc%%|*}" == "$current" ]]; then
                found=1
                break
            fi
        done
        if [[ $found -eq 1 ]]; then
            echo -e "Akun Aktif: ${GREEN}${BOLD}$current${NC}"
        else
            echo -e "Akun Aktif: ${GREEN}${BOLD}$current${NC} ${YELLOW}(belum disimpan ke profil, gunakan 'gma save')${NC}"
        fi
    fi
}

# ------------------------------------------------------------------------------
# Command: current
# ------------------------------------------------------------------------------
current_account() {
    local email
    email=$(get_current_email)
    if [[ "$email" == "none" ]]; then
        echo -e "${YELLOW}Tidak ada akun aktif.${NC}"
    else
        local meta
        meta=$(get_account_meta "$email")
        local alias
        alias=$(echo "$meta" | cut -d'|' -f1)
        local model
        model=$(echo "$meta" | cut -d'|' -f2)

        local extra=""
        [[ -n "$alias" ]] && extra+=" [Alias: $alias]"
        [[ -n "$model" ]] && extra+=" [Model: $model]"
        echo -e "Akun Aktif: ${GREEN}${BOLD}$email${NC}${CYAN}$extra${NC}"
    fi
}

# ------------------------------------------------------------------------------
# Internal helper: Backup current active credentials
# ------------------------------------------------------------------------------
backup_current() {
    local email
    email=$(get_current_email)
    if [[ "$email" != "none" && "$email" != "unknown" ]]; then
        local safe_email
        safe_email=$(sanitize_email "$email")
        local prof_dir="$ACCOUNTS_DIR/$safe_email"
        mkdir -p "$prof_dir"
        
        [[ -f "$TOKEN_FILE" ]] && cp -p "$TOKEN_FILE" "$prof_dir/oauth-token"
        [[ -f "$CRED_FILE" ]] && cp -p "$CRED_FILE" "$prof_dir/credentials.json"
        [[ -f "$GOOGLE_ACC_FILE" ]] && cp -p "$GOOGLE_ACC_FILE" "$prof_dir/google_accounts.json"
        [[ -f "$SETTINGS_FILE" ]] && cp -p "$SETTINGS_FILE" "$prof_dir/settings.json"
        
        # Preserve existing meta fields (alias, model, etc)
        local meta_file="$prof_dir/meta.json"
        if [[ -f "$meta_file" ]] && command -v python3 &>/dev/null; then
            python3 -c "
import json, datetime
try:
    with open('$meta_file') as f:
        d = json.load(f)
except Exception:
    d = {}
d['email'] = '$email'
d['updated_at'] = datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
with open('$meta_file', 'w') as f:
    json.dump(d, f, indent=2)
"
        else
            local now
            now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
            echo "{\"email\":\"$email\",\"updated_at\":\"$now\"}" > "$meta_file"
        fi
    fi
}

# ------------------------------------------------------------------------------
# Command: save
# ------------------------------------------------------------------------------
save_account() {
    local email
    email=$(get_current_email)
    if [[ "$email" == "none" || "$email" == "unknown" ]]; then
        echo -e "${RED}Gagal menyimpan: Tidak ada akun aktif atau token tidak valid.${NC}"
        exit 1
    fi
    backup_current
    echo -e "${GREEN}✓ Akun '${email}' berhasil disimpan ke profil.${NC}"
}

# ------------------------------------------------------------------------------
# Command: switch
# ------------------------------------------------------------------------------
switch_account() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        echo -e "${RED}Error: Masukkan nomor urut (index), alias, atau email akun yang ingin digunakan.${NC}"
        echo -e "Contoh: ${CYAN}gma switch 1${NC} atau ${CYAN}gma switch primary${NC} atau ${CYAN}gma switch user@gmail.com${NC}"
        exit 1
    fi

    local accounts=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && accounts+=("$line")
    done < <(get_saved_accounts)

    if [[ ${#accounts[@]} -eq 0 ]]; then
        echo -e "${RED}Tidak ada akun tersimpan. Gunakan 'gma add' terlebih dahulu.${NC}"
        exit 1
    fi

    local target_dir=""
    local target_email=""
    local target_alias=""
    local target_model=""
    
    local idx=1
    for acc in "${accounts[@]}"; do
        local email
        local dir
        local alias
        local model
        email=$(echo "$acc" | cut -d'|' -f1)
        dir=$(echo "$acc" | cut -d'|' -f2)
        alias=$(echo "$acc" | cut -d'|' -f3)
        model=$(echo "$acc" | cut -d'|' -f4)

        if [[ "$target" == "$email" || "$target" == "$idx" || ( -n "$alias" && "${target,,}" == "${alias,,}" ) ]]; then
            target_dir="$dir"
            target_email="$email"
            target_alias="$alias"
            target_model="$model"
            break
        fi
        idx=$((idx + 1))
    done
    
    if [[ -z "$target_dir" ]]; then
        echo -e "${RED}Akun '$target' tidak ditemukan di profil tersimpan.${NC}"
        echo -e "Jalankan ${CYAN}gma list${NC} untuk melihat daftar akun yang tersedia."
        exit 1
    fi
    
    local disp_name="$target_email"
    [[ -n "$target_alias" ]] && disp_name="$target_email [$target_alias]"
    echo -e "${BLUE}Mengganti akun aktif ke: ${BOLD}$disp_name${NC}..."
    
    # Backup current session before switching
    backup_current
    
    # Copy target profile to active files
    mkdir -p "$(dirname "$TOKEN_FILE")"
    
    if [[ -f "$target_dir/oauth-token" ]]; then
        cp -p "$target_dir/oauth-token" "$TOKEN_FILE"
        chmod 600 "$TOKEN_FILE"
    fi
    
    if [[ -f "$target_dir/credentials.json" ]]; then
        cp -p "$target_dir/credentials.json" "$CRED_FILE"
        chmod 600 "$CRED_FILE"
    else
        rm -f "$CRED_FILE"
    fi

    if [[ -f "$target_dir/settings.json" ]]; then
        cp -p "$target_dir/settings.json" "$SETTINGS_FILE"
    fi
    
    if [[ -f "$target_dir/google_accounts.json" ]]; then
        cp -p "$target_dir/google_accounts.json" "$GOOGLE_ACC_FILE"
    else
        echo "{\"active\": null, \"old\": [\"$target_email\"]}" > "$GOOGLE_ACC_FILE"
    fi

    # Apply per-account custom model to settings.json if configured
    if [[ -n "$target_model" && -f "$SETTINGS_FILE" ]] && command -v python3 &>/dev/null; then
        python3 -c "
import json
try:
    with open('$SETTINGS_FILE') as f:
        s = json.load(f)
    s['model'] = '$target_model'
    with open('$SETTINGS_FILE', 'w') as f:
        json.dump(s, f, indent=2)
except Exception:
    pass
" 2>/dev/null || true
        echo -e "✓ Model otomatis diatur ke: ${CYAN}${target_model}${NC}"
    fi
    
    echo -e "${GREEN}✓ Berhasil beralih ke: ${BOLD}$disp_name${NC}"

    # Termux notification
    send_termux_notification "🚀 GMA: Akun Aktif Berganti" "Beralih ke: $disp_name" "high"
}

# ------------------------------------------------------------------------------
# Command: next (Auto-switch / Rotate to next account)
# ------------------------------------------------------------------------------
next_account() {
    local accounts=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && accounts+=("$line")
    done < <(get_saved_accounts)

    local total=${#accounts[@]}
    if [[ $total -le 1 ]]; then
        echo -e "${YELLOW}Hanya ada $total akun tersimpan. Tambah akun lain dengan 'gma add' untuk rotasi.${NC}"
        return 0
    fi

    # Filter accounts enabled for auto-rotation
    local rot_accounts=()
    for acc in "${accounts[@]}"; do
        local auto_rot
        auto_rot=$(echo "$acc" | cut -d'|' -f5)
        if [[ "$auto_rot" != "false" ]]; then
            rot_accounts+=("$acc")
        fi
    done

    if [[ ${#rot_accounts[@]} -eq 0 ]]; then
        echo -e "${YELLOW}Semua akun dinonaktifkan dari auto-rotate. Menggunakan seluruh akun tersimpan...${NC}"
        rot_accounts=("${accounts[@]}")
    fi

    local rot_total=${#rot_accounts[@]}
    local current
    current=$(get_current_email)
    local current_rot_idx=0

    for i in "${!rot_accounts[@]}"; do
        local acc_email
        acc_email=$(echo "${rot_accounts[$i]}" | cut -d'|' -f1)
        if [[ "$acc_email" == "$current" ]]; then
            current_rot_idx=$((i + 1))
            break
        fi
    done

    # Next index with round-robin wrap around
    local next_rot_idx=$(( (current_rot_idx % rot_total) + 1 ))
    local next_acc="${rot_accounts[$((next_rot_idx - 1))]}"
    local next_email
    local next_alias
    next_email=$(echo "$next_acc" | cut -d'|' -f1)
    next_alias=$(echo "$next_acc" | cut -d'|' -f3)

    local disp_target="$next_email"
    [[ -n "$next_alias" ]] && disp_target="$next_email [$next_alias]"

    echo -e "${CYAN}🔄 [Auto-Rotate] Beralih ke (${next_rot_idx}/${rot_total}): ${BOLD}${disp_target}${NC}"
    switch_account "$next_email" >/dev/null
    echo -e "${GREEN}✓ Akun aktif sekarang: ${BOLD}${disp_target}${NC} (${next_rot_idx}/${rot_total})"

    # Termux notification
    send_termux_notification "🔄 GMA Auto-Switch" "Akun aktif sekarang: $disp_target" "high"
}

# ------------------------------------------------------------------------------
# Command: config / set (Configure per-account settings)
# ------------------------------------------------------------------------------
config_account() {
    local target="${1:-}"

    if [[ -z "$target" ]]; then
        # Interactive account selection for config
        list_accounts
        echo ""
        echo -n "Masukkan nomor urut, email, atau alias akun yang ingin dikonfigurasi: "
        read -r target
        if [[ -z "$target" ]]; then
            echo "Dibatalkan."
            return 0
        fi
    fi

    # Find account
    local accounts=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && accounts+=("$line")
    done < <(get_saved_accounts)

    local target_email=""
    local idx=1
    for acc in "${accounts[@]}"; do
        local email
        local alias
        email=$(echo "$acc" | cut -d'|' -f1)
        alias=$(echo "$acc" | cut -d'|' -f3)
        if [[ "$target" == "$email" || "$target" == "$idx" || ( -n "$alias" && "${target,,}" == "${alias,,}" ) ]]; then
            target_email="$email"
            break
        fi
        idx=$((idx + 1))
    done

    if [[ -z "$target_email" ]]; then
        echo -e "${RED}Akun '$target' tidak ditemukan.${NC}"
        return 1
    fi

    shift || true

    # Check for CLI flags: --alias, --model, --effort, --rotate, --notes
    local new_alias=""
    local new_model=""
    local new_effort=""
    local new_rotate=""
    local new_notes=""
    local has_flags=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --alias) new_alias="$2"; has_flags=1; shift 2 ;;
            --model) new_model="$2"; has_flags=1; shift 2 ;;
            --effort) new_effort="$2"; has_flags=1; shift 2 ;;
            --rotate) new_rotate="$2"; has_flags=1; shift 2 ;;
            --notes) new_notes="$2"; has_flags=1; shift 2 ;;
            *) shift ;;
        esac
    done

    if [[ $has_flags -eq 1 ]]; then
        [[ -n "$new_alias" ]] && update_account_meta "$target_email" "alias" "$new_alias"
        [[ -n "$new_model" ]] && update_account_meta "$target_email" "model" "$new_model"
        [[ -n "$new_effort" ]] && update_account_meta "$target_email" "effort" "$new_effort"
        [[ -n "$new_rotate" ]] && update_account_meta "$target_email" "auto_rotate" "$new_rotate"
        [[ -n "$new_notes" ]] && update_account_meta "$target_email" "notes" "$new_notes"
        echo -e "${GREEN}✓ Konfigurasi akun ${BOLD}$target_email${NC}${GREEN} berhasil diperbarui!${NC}"
        return 0
    fi

    # Interactive Configuration Wizard
    local meta
    meta=$(get_account_meta "$target_email")
    local cur_alias
    local cur_model
    local cur_effort
    local cur_rotate
    local cur_notes
    cur_alias=$(echo "$meta" | cut -d'|' -f1)
    cur_model=$(echo "$meta" | cut -d'|' -f2)
    cur_effort=$(echo "$meta" | cut -d'|' -f3)
    cur_rotate=$(echo "$meta" | cut -d'|' -f4)
    cur_notes=$(echo "$meta" | cut -d'|' -f5)

    echo ""
    echo -e "${BLUE}=== ⚙️  Konfigurasi Kustom Akun ===${NC}"
    echo -e "Akun: ${GREEN}${BOLD}$target_email${NC}"
    echo "------------------------------------------------------------"
    
    # 1. Alias
    echo -e "Alias / Label saat ini: ${MAGENTA}${cur_alias:-[Belum diatur]}${NC}"
    echo -n "Masukkan alias baru (tekan Enter untuk tidak mengubah, '-' untuk hapus): "
    read -r inp_alias
    if [[ "$inp_alias" == "-" ]]; then
        update_account_meta "$target_email" "alias" ""
        echo "  ✓ Alias dihapus."
    elif [[ -n "$inp_alias" ]]; then
        update_account_meta "$target_email" "alias" "$inp_alias"
        echo "  ✓ Alias diatur ke: $inp_alias"
    fi

    # 2. Model
    echo ""
    echo -e "Default Model saat ini: ${CYAN}${cur_model:-[Bawaan Sistem]}${NC}"
    echo "Pilihan model populer:"
    echo "  1) Gemini 3.8 Flash (High)"
    echo "  2) Gemini 3.8 Flash (Medium)"
    echo "  3) Gemini 3.7 Flash (High)"
    echo "  4) Gemini 3.1 Pro (High)"
    echo "  5) Claude Sonnet 4.6 (Thinking)"
    echo "  6) Custom input"
    echo "  0) Hapus custom model (gunakan default AGY)"
    echo -n "Pilih opsi [0-6, Enter untuk lewati]: "
    read -r inp_mod_opt
    case "$inp_mod_opt" in
        1) update_account_meta "$target_email" "model" "Gemini 3.8 Flash (High)"; echo "  ✓ Model diatur ke: Gemini 3.8 Flash (High)" ;;
        2) update_account_meta "$target_email" "model" "Gemini 3.8 Flash (Medium)"; echo "  ✓ Model diatur ke: Gemini 3.8 Flash (Medium)" ;;
        3) update_account_meta "$target_email" "model" "Gemini 3.7 Flash (High)"; echo "  ✓ Model diatur ke: Gemini 3.7 Flash (High)" ;;
        4) update_account_meta "$target_email" "model" "Gemini 3.1 Pro (High)"; echo "  ✓ Model diatur ke: Gemini 3.1 Pro (High)" ;;
        5) update_account_meta "$target_email" "model" "Claude Sonnet 4.6 (Thinking)"; echo "  ✓ Model diatur ke: Claude Sonnet 4.6 (Thinking)" ;;
        6) 
            echo -n "Masukkan nama model persis: "
            read -r custom_m
            [[ -n "$custom_m" ]] && update_account_meta "$target_email" "model" "$custom_m"
            ;;
        0) update_account_meta "$target_email" "model" ""; echo "  ✓ Custom model dihapus." ;;
        *) ;;
    esac

    # 3. Auto-Rotate Toggle
    echo ""
    local rot_disp="Aktif"
    [[ "$cur_rotate" == "False" || "$cur_rotate" == "false" ]] && rot_disp="Nonaktif"
    echo -e "Status Auto-Rotate saat ini: ${YELLOW}$rot_disp${NC}"
    echo -n "Sertakan akun ini dalam rotasi otomatis saat kuota habis? (y/n, Enter untuk lewati): "
    read -r inp_rot
    if [[ "$inp_rot" =~ ^[Yy]$ ]]; then
        update_account_meta "$target_email" "auto_rotate" "true"
        echo "  ✓ Auto-rotate diaktifkan untuk akun ini."
    elif [[ "$inp_rot" =~ ^[Nn]$ ]]; then
        update_account_meta "$target_email" "auto_rotate" "false"
        echo "  ✓ Auto-rotate dinonaktifkan (akun tidak akan tersentuh saat rotasi otomatis)."
    fi

    # 4. Notes
    echo ""
    echo -e "Catatan saat ini: ${cur_notes:-[Kosong]}"
    echo -n "Catatan baru (tekan Enter untuk lewati, '-' untuk hapus): "
    read -r inp_notes
    if [[ "$inp_notes" == "-" ]]; then
        update_account_meta "$target_email" "notes" ""
    elif [[ -n "$inp_notes" ]]; then
        update_account_meta "$target_email" "notes" "$inp_notes"
    fi

    echo ""
    echo -e "${GREEN}✓ Konfigurasi akun ${BOLD}$target_email${NC}${GREEN} selesai disimpan!${NC}"
}

# ------------------------------------------------------------------------------
# Command: test-notif
# ------------------------------------------------------------------------------
test_notification() {
    echo -e "${BLUE}=== 🔔 Menguji Notifikasi Termux ===${NC}"
    
    local has_termux_api=0
    if command -v termux-notification &>/dev/null; then
        has_termux_api=1
        echo -e "${GREEN}✓ Paket 'termux-api' ditemukan di Termux.${NC}"
    else
        echo -e "${YELLOW}ℹ️  'termux-notification' belum terpasang.${NC}"
        echo -e "Agar notifikasi pop-up muncul di status bar Android, jalankan:"
        echo -e "  ${CYAN}pkg install termux-api${NC}"
        echo -e "Dan instal aplikasi pendamping ${BOLD}Termux:API${NC} dari F-Droid atau GitHub."
        echo ""
    fi

    send_termux_notification "🚀 GMA (Good Mode AGY)" "Uji coba notifikasi Termux berhasil! Sistem GMA siap beroperasi." "high"
    echo -e "${GREEN}✓ Sinyal notifikasi telah dikirimkan!${NC}"
}

# ------------------------------------------------------------------------------
# Command: add
# ------------------------------------------------------------------------------
add_account() {
    echo -e "${BLUE}=== 🚀 ${APP_NAME} - Tambah Akun Baru ===${NC}"
    echo -e "${YELLOW}Proses ini akan menjalankan otentikasi Google untuk akun baru.${NC}"
    echo ""

    local AGY_BIN
    if ! AGY_BIN=$(get_agy_binary); then
        echo -e "${RED}Error: Binary 'agy' yang dapat dieksekusi tidak ditemukan.${NC}"
        exit 1
    fi

    # Backup current account first
    local current_email
    current_email=$(get_current_email)
    if [[ "$current_email" != "none" && "$current_email" != "unknown" ]]; then
        echo -e "Menyimpan akun saat ini (${GREEN}$current_email${NC}) terlebih dahulu..."
        backup_current
        echo -e "${GREEN}✓ Akun saat ini aman dibackup.${NC}"
    fi

    local tmp_backup="$GEMINI_DIR/tmp/agy_auth_$$"
    mkdir -p "$tmp_backup"

    # Temporarily move active credentials
    [[ -f "$TOKEN_FILE" ]] && mv "$TOKEN_FILE" "$tmp_backup/"
    [[ -f "$CRED_FILE" ]] && mv "$CRED_FILE" "$tmp_backup/"

    cleanup_on_interrupt() {
        echo -e "\n${YELLOW}Operasi dibatalkan. Mengembalikan akun sebelumnya...${NC}"
        [[ -f "$tmp_backup/antigravity-oauth-token" && ! -f "$TOKEN_FILE" ]] && mv "$tmp_backup/antigravity-oauth-token" "$TOKEN_FILE"
        [[ -f "$tmp_backup/gemini-credentials.json" && ! -f "$CRED_FILE" ]] && mv "$tmp_backup/gemini-credentials.json" "$CRED_FILE"
        rm -rf "$tmp_backup"
        exit 130
    }
    trap cleanup_on_interrupt INT TERM

    echo ""
    echo -e "${BLUE}=== Memulai Autentikasi Google ===${NC}"
    echo -e "${YELLOW}1. Buka URL yang ditampilkan di browser.${NC}"
    echo -e "${YELLOW}2. Selesaikan login Google dengan akun yang baru.${NC}"
    echo -e "${YELLOW}3. Jika kode otorisasi diberikan, salin dan tempel di sini, lalu tekan Enter.${NC}"
    echo ""

    local agy_exit=0
    "$AGY_BIN" --print "." || agy_exit=$?

    if [[ ! -f "$TOKEN_FILE" ]]; then
        echo ""
        echo -e "${RED}Autentikasi gagal, dibatalkan, atau waktu habis.${NC}"
        [[ -f "$tmp_backup/antigravity-oauth-token" ]] && mv "$tmp_backup/antigravity-oauth-token" "$TOKEN_FILE"
        [[ -f "$tmp_backup/gemini-credentials.json" ]] && mv "$tmp_backup/gemini-credentials.json" "$CRED_FILE"
        rm -rf "$tmp_backup"
        trap - INT TERM
        exit 1
    fi

    local new_email
    new_email=$(get_current_email)
    if [[ "$new_email" == "none" || "$new_email" == "unknown" ]]; then
        echo -e "${RED}Gagal membaca email dari login baru.${NC}"
        [[ -f "$tmp_backup/antigravity-oauth-token" ]] && mv "$tmp_backup/antigravity-oauth-token" "$TOKEN_FILE"
        [[ -f "$tmp_backup/gemini-credentials.json" ]] && mv "$tmp_backup/gemini-credentials.json" "$CRED_FILE"
        rm -rf "$tmp_backup"
        trap - INT TERM
        exit 1
    fi

    if [[ "$new_email" == "$current_email" ]]; then
        echo -e "${YELLOW}Peringatan: Anda login dengan akun yang sama ($new_email). Tidak ada akun baru yang ditambahkan.${NC}"
        rm -rf "$tmp_backup"
        trap - INT TERM
        exit 0
    fi

    echo -e "${GREEN}✓ Berhasil login dengan akun: ${BOLD}$new_email${NC}"
    backup_current
    echo -e "${GREEN}✓ Akun baru berhasil disimpan ke profil GMA!${NC}"

    echo ""
    echo -n "Beri alias/nama panggilan untuk akun ini (kosongkan jika tidak ada): "
    read -r quick_alias
    if [[ -n "$quick_alias" ]]; then
        update_account_meta "$new_email" "alias" "$quick_alias"
        echo -e "${GREEN}✓ Alias '${quick_alias}' disimpan.${NC}"
    fi

    echo ""
    echo -e "Gunakan ${CYAN}gma switch <nomor|email|alias>${NC} atau ${CYAN}gma next${NC} untuk beralih akun."
    
    send_termux_notification "🚀 GMA: Akun Baru Ditambahkan" "Akun $new_email siap digunakan." "default"

    trap - INT TERM
    rm -rf "$tmp_backup"
}

# ------------------------------------------------------------------------------
# Command: remove
# ------------------------------------------------------------------------------
remove_account() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        echo -e "${RED}Error: Masukkan email, nomor akun, atau alias yang ingin dihapus.${NC}"
        exit 1
    fi
    
    local accounts=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && accounts+=("$line")
    done < <(get_saved_accounts)

    local target_dir=""
    local target_email=""
    
    local idx=1
    for acc in "${accounts[@]}"; do
        local email
        local dir
        local alias
        email=$(echo "$acc" | cut -d'|' -f1)
        dir=$(echo "$acc" | cut -d'|' -f2)
        alias=$(echo "$acc" | cut -d'|' -f3)
        if [[ "$target" == "$email" || "$target" == "$idx" || ( -n "$alias" && "${target,,}" == "${alias,,}" ) ]]; then
            target_dir="$dir"
            target_email="$email"
            break
        fi
        idx=$((idx + 1))
    done
    
    if [[ -z "$target_dir" ]]; then
        echo -e "${RED}Akun '$target' tidak ditemukan.${NC}"
        exit 1
    fi
    
    echo -e "${YELLOW}Apakah Anda yakin ingin menghapus profil akun ${BOLD}$target_email${NC}${YELLOW}? (y/N)${NC}"
    read -r confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        local current_email
        current_email=$(get_current_email)
        rm -rf "$target_dir"
        if [[ "$target_email" == "$current_email" ]]; then
            rm -f "$TOKEN_FILE" "$CRED_FILE"
            echo -e "${YELLOW}Sesi aktif telah dihapus karena akun yang dihapus sedang aktif.${NC}"
        fi
        echo -e "${GREEN}✓ Akun $target_email berhasil dihapus.${NC}"
    else
        echo "Dibatalkan."
    fi
}

# ------------------------------------------------------------------------------
# Command: status (Inspect token, expiry, and connectivity)
# ------------------------------------------------------------------------------
status_account() {
    local do_ping=0
    if [[ "${1:-}" == "--ping" || "${1:-}" == "-p" ]]; then
        do_ping=1
    fi

    echo -e "${BLUE}=== 🚀 ${APP_NAME} v${VERSION} - Status & Token Inspection ===${NC}"
    local current
    current=$(get_current_email)

    if [[ "$current" == "none" ]]; then
        echo -e "Akun Aktif     : ${YELLOW}Tidak ada (Silakan login atau 'gma switch')${NC}"
    else
        local meta
        meta=$(get_account_meta "$current")
        local alias
        local model
        alias=$(echo "$meta" | cut -d'|' -f1)
        model=$(echo "$meta" | cut -d'|' -f2)
        local extra=""
        [[ -n "$alias" ]] && extra+=" [Alias: $alias]"
        [[ -n "$model" ]] && extra+=" [Model: $model]"
        echo -e "Akun Aktif     : ${GREEN}${BOLD}$current${NC}${CYAN}$extra${NC}"
    fi

    if [[ -f "$TOKEN_FILE" ]]; then
        echo -e "File Token     : ${GREEN}Tersedia${NC} (${TOKEN_FILE})"
        if command -v python3 &>/dev/null; then
            python3 -c "
import json, sys
from datetime import datetime, timezone

try:
    with open('$TOKEN_FILE') as f:
        data = json.load(f)
    tok = data.get('token', {})
    expiry_str = tok.get('expiry', '')
    has_refresh = 'Ya' if tok.get('refresh_token') else 'Tidak'
    print(f'Refresh Token  : \033[0;32m{has_refresh}\033[0m (Auto-refresh token siap)')
    
    if expiry_str:
        clean_str = expiry_str.split('.')[0] + 'Z' if '.' in expiry_str else expiry_str
        exp_dt = datetime.strptime(clean_str, '%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=timezone.utc)
        now_dt = datetime.now(timezone.utc)
        diff = int((exp_dt - now_dt).total_seconds())
        if diff > 0:
            mins = diff // 60
            hrs = mins // 60
            remaining = f'{hrs}j {mins % 60}m' if hrs > 0 else f'{mins}m'
            print(f'Masa Token     : \033[0;32mValid\033[0m (berlaku ~{remaining} lagi)')
        else:
            print('Masa Token     : \033[0;33mKedaluwarsa (akan di-refresh otomatis oleh AGY)\033[0m')
except Exception as e:
    print('Masa Token     : \033[0;33mTidak dapat dianalisis\033[0m')
" 2>/dev/null || true
        fi
    else
        echo -e "File Token     : ${RED}Tidak ditemukan${NC}"
    fi

    # Saved accounts summary
    local accounts=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && accounts+=("$line")
    done < <(get_saved_accounts)

    echo ""
    echo -e "${BLUE}Daftar Akun Tersimpan (${#accounts[@]} Akun):${NC}"
    local idx=1
    for acc in "${accounts[@]}"; do
        local email
        local dir
        local alias
        local model
        local auto_rot
        email=$(echo "$acc" | cut -d'|' -f1)
        dir=$(echo "$acc" | cut -d'|' -f2)
        alias=$(echo "$acc" | cut -d'|' -f3)
        model=$(echo "$acc" | cut -d'|' -f4)
        auto_rot=$(echo "$acc" | cut -d'|' -f5)

        local mark="  "
        if [[ "$email" == "$current" ]]; then
            mark="${GREEN}* ${NC}"
        fi
        local has_tok="[No Token]"
        if [[ -f "$dir/oauth-token" ]]; then
            has_tok="${GREEN}[Siap]${NC}"
        fi

        local details=""
        [[ -n "$alias" ]] && details+=" ${MAGENTA}[$alias]${NC}"
        [[ -n "$model" ]] && details+=" ${CYAN}($model)${NC}"
        [[ "$auto_rot" == "false" ]] && details+=" ${YELLOW}[No-Rotate]${NC}"

        echo -e "${mark}${BOLD}${idx}.${NC} ${email} ${has_tok}${details}"
        idx=$((idx + 1))
    done

    if [[ $do_ping -eq 1 ]]; then
        echo ""
        echo -e "${BLUE}Mengecek konektivitas API dengan Google Antigravity...${NC}"
        local AGY_BIN
        if AGY_BIN=$(get_agy_binary); then
            if "$AGY_BIN" models >/dev/null 2>&1; then
                echo -e "${GREEN}✓ Koneksi API berhasil & kuota akun aktif tersedia!${NC}"
            else
                echo -e "${RED}✗ Gagal menghubungi API atau kuota akun habis.${NC}"
            fi
        fi
    fi
}

# ------------------------------------------------------------------------------
# Command: run (Execute agy with Auto-Switch on Rate Limit / Quota Exceeded)
# ------------------------------------------------------------------------------
run_with_autoswitch() {
    local AGY_BIN
    if ! AGY_BIN=$(get_agy_binary); then
        echo -e "${RED}Error: Binary 'agy' tidak ditemukan.${NC}"
        exit 1
    fi

    local accounts=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && accounts+=("$line")
    done < <(get_saved_accounts)

    local total_accounts=${#accounts[@]}
    local max_attempts=$(( total_accounts > 0 ? total_accounts : 1 ))
    local attempt=1

    # Check if this invocation is batch/print mode
    local is_batch=0
    for arg in "$@"; do
        if [[ "$arg" == "-p" || "$arg" == "--print" || "$arg" == "--prompt" ]]; then
            is_batch=1
            break
        fi
    done

    if [[ $is_batch -eq 1 ]]; then
        # Batch mode: auto-retry through accounts automatically
        while [[ $attempt -le $max_attempts ]]; do
            local current_email
            current_email=$(get_current_email)
            echo -e "${BLUE}[GMA] Menjalankan perintah dengan akun: ${GREEN}$current_email${NC} (Percobaan $attempt/$max_attempts)..."
            
            local tmp_out="$GEMINI_DIR/tmp/gma_run_$$.log"
            mkdir -p "$(dirname "$tmp_out")"
            
            local exit_code=0
            "$AGY_BIN" "$@" 2>&1 | tee "$tmp_out" || exit_code=$?

            # Inspect output for rate-limit / quota errors
            if [[ $exit_code -ne 0 ]] || grep -qiE "RESOURCE_EXHAUSTED|429|quota exceeded|quota_exceeded|rate limit|rate_limit|rate-limit|exhausted your quota|capacity" "$tmp_out"; then
                echo ""
                echo -e "${YELLOW}[GMA] ⚠️ Kuota habis atau Rate Limit terdeteksi pada akun: ${RED}$current_email${NC}"
                rm -f "$tmp_out"
                if [[ $attempt -lt $max_attempts ]]; then
                    echo -e "${CYAN}[GMA] 🔄 Mengganti ke akun berikutnya secara otomatis...${NC}"
                    send_termux_notification "⚠️ GMA: Limit Kuota" "Auto-switch dari $current_email ke akun selanjutnya..." "high"
                    next_account >/dev/null
                    attempt=$((attempt + 1))
                    echo ""
                    continue
                else
                    echo -e "${RED}[GMA] ✗ Semua $total_accounts akun tersimpan telah dicoba atau mencapai limit!${NC}"
                    send_termux_notification "🚨 GMA: Kuota Habis" "Seluruh akun telah mencapai limit kuota." "high"
                    return $exit_code
                fi
            else
                rm -f "$tmp_out"
                return $exit_code
            fi
        done
    else
        # Interactive mode: launch directly
        local current_email
        current_email=$(get_current_email)
        echo -e "${BLUE}=== 🚀 ${APP_NAME} - Running Antigravity ===${NC}"
        echo -e "Akun Aktif: ${GREEN}${BOLD}$current_email${NC}"
        echo ""

        local tmp_log="$GEMINI_DIR/tmp/gma_interactive_$$.log"
        mkdir -p "$(dirname "$tmp_log")"
        local exit_code=0

        "$AGY_BIN" "$@" 2>&1 | tee "$tmp_log" || exit_code=$?

        if grep -qiE "RESOURCE_EXHAUSTED|429|quota exceeded|rate limit|exhausted your quota" "$tmp_log"; then
            echo ""
            echo -e "${YELLOW}[GMA] ⚠️ Sesi terhenti karena batasan kuota / Rate Limit.${NC}"
            send_termux_notification "⚠️ GMA: Sesi Limit" "Sesi agy terhenti karena limit kuota." "high"
            if [[ $total_accounts -gt 1 ]]; then
                echo -e "${BLUE}Apakah Anda ingin beralih ke akun berikutnya dan melanjutkan percakapan (--continue)? [Y/n]${NC} "
                read -r ans
                if [[ "$ans" =~ ^[Yy]$ || -z "$ans" ]]; then
                    next_account
                    rm -f "$tmp_log"
                    exec "$0" run --continue
                fi
            fi
        fi
        rm -f "$tmp_log"
        return $exit_code
    fi
}

# ------------------------------------------------------------------------------
# Command: export (Backup profiles to tar.gz)
# ------------------------------------------------------------------------------
export_accounts() {
    local default_filename="gma-accounts-backup-$(date +%Y%m%d_%H%M%S).tar.gz"
    local output_path="${1:-$HOME_DIR/$default_filename}"

    if [[ ! -d "$ACCOUNTS_DIR" ]] || [[ -z "$(ls -A "$ACCOUNTS_DIR" 2>/dev/null)" ]]; then
        echo -e "${RED}Error: Tidak ada profil akun tersimpan di $ACCOUNTS_DIR untuk diekspor.${NC}"
        exit 1
    fi

    # Backup current session state first so latest tokens are included
    backup_current

    echo -e "${BLUE}Mengekspor akun ke: ${BOLD}$output_path${NC}..."
    tar -czf "$output_path" -C "$GEMINI_DIR" accounts
    chmod 600 "$output_path"

    local size
    size=$(du -h "$output_path" | cut -f1)
    echo -e "${GREEN}✓ Berhasil diekspor! Ukuran file: $size${NC}"
    echo -e "Simpan file backup ini di tempat yang aman."
    send_termux_notification "📦 GMA: Backup Berhasil" "Arsip tersimpan di $output_path" "default"
}

# ------------------------------------------------------------------------------
# Command: import (Restore profiles from tar.gz)
# ------------------------------------------------------------------------------
import_accounts() {
    local backup_file="${1:-}"
    if [[ -z "$backup_file" ]]; then
        echo -e "${RED}Error: Masukkan path file backup (.tar.gz).${NC}"
        echo -e "Contoh: ${CYAN}gma import ~/gma-accounts-backup.tar.gz${NC}"
        exit 1
    fi

    if [[ ! -f "$backup_file" ]]; then
        echo -e "${RED}Error: File backup '$backup_file' tidak ditemukan.${NC}"
        exit 1
    fi

    echo -e "${BLUE}Mengimpor profil akun dari: ${BOLD}$backup_file${NC}..."
    mkdir -p "$GEMINI_DIR"
    tar -xzf "$backup_file" -C "$GEMINI_DIR"
    chmod -R 700 "$ACCOUNTS_DIR"

    local count
    count=$(get_saved_accounts | wc -l)
    echo -e "${GREEN}✓ Berhasil mengimpor! Total $count akun siap digunakan.${NC}"
    echo -e "Gunakan ${CYAN}gma list${NC} untuk melihat daftar akun yang diimpor."
    send_termux_notification "📥 GMA: Restore Berhasil" "$count akun berhasil dipulihkan." "default"
}

# ------------------------------------------------------------------------------
# Command: menu (Interactive TUI for Termux)
# ------------------------------------------------------------------------------
interactive_menu() {
    while true; do
        clear || true
        local current
        current=$(get_current_email)
        local accounts=()
        while IFS= read -r line; do
            [[ -n "$line" ]] && accounts+=("$line")
        done < <(get_saved_accounts)

        local cur_str
        if [[ "$current" == "none" ]]; then
            cur_str="${YELLOW}Tidak ada${NC}"
        else
            local meta
            meta=$(get_account_meta "$current")
            local al
            al=$(echo "$meta" | cut -d'|' -f1)
            local extra=""
            [[ -n "$al" ]] && extra=" ${MAGENTA}[$al]${NC}"
            cur_str="${GREEN}${BOLD}$current${NC}${extra}"
        fi

        echo -e "${BLUE}╔════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${BLUE}║            🚀 ${BOLD}${APP_NAME} v${VERSION}${NC}${BLUE}                  ║${NC}"
        echo -e "${BLUE}║      Multi-Account Manager & Auto-Switcher for Termux      ║${NC}"
        echo -e "${BLUE}╚════════════════════════════════════════════════════════════╝${NC}"
        echo -e " Akun Aktif: $cur_str | Tersimpan: ${BOLD}${#accounts[@]}${NC} akun"
        echo -e "------------------------------------------------------------"
        echo -e "  ${CYAN}1)${NC} 📋 Daftar Semua Akun Tersimpan (List)"
        echo -e "  ${CYAN}2)${NC} 🔄 Ganti Akun Aktif (Switch)"
        echo -e "  ${CYAN}3)${NC} ⏭️  Auto-Rotate ke Akun Berikutnya (Next)"
        echo -e "  ${CYAN}4)${NC} ⚙️  Konfigurasi Kustom Akun (Alias, Model, Auto-Rotate)"
        echo -e "  ${CYAN}5)${NC} ➕ Tambah Akun Baru (Add / Google Auth)"
        echo -e "  ${CYAN}6)${NC} 💾 Simpan Akun Aktif Saat Ini (Save)"
        echo -e "  ${CYAN}7)${NC} 📊 Cek Status & Token (Status / Quota)"
        echo -e "  ${CYAN}8)${NC} ⚡ Jalankan AGY Mode Proteksi Kuota (gma run)"
        echo -e "  ${CYAN}9)${NC} 🚀 Jalankan Antigravity CLI Interaktif"
        echo -e " ${CYAN}10)${NC} 🔔 Uji Coba Notifikasi Termux"
        echo -e " ${CYAN}11)${NC} 📦 Backup / Export Akun (.tar.gz)"
        echo -e " ${CYAN}12)${NC} 📥 Restore / Import Akun (.tar.gz)"
        echo -e " ${CYAN}13)${NC} 🗑️  Hapus Akun Tersimpan (Remove)"
        echo -e "  ${CYAN}0)${NC} 🚪 Keluar"
        echo -e "------------------------------------------------------------"
        echo -n "Pilih menu [0-13]: "
        read -r choice

        case "$choice" in
            1)
                echo ""
                list_accounts
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            2)
                echo ""
                list_accounts
                echo ""
                echo -n "Masukkan nomor urut, email, atau alias yang ingin diaktifkan: "
                read -r target
                if [[ -n "$target" ]]; then
                    switch_account "$target"
                fi
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            3)
                echo ""
                next_account
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            4)
                echo ""
                config_account ""
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            5)
                echo ""
                add_account
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            6)
                echo ""
                save_account
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            7)
                echo ""
                status_account
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            8)
                echo ""
                echo -n "Masukkan prompt atau argumen untuk agy (kosongkan untuk interaktif): "
                read -r user_prompt
                if [[ -n "$user_prompt" ]]; then
                    run_with_autoswitch --print "$user_prompt"
                else
                    run_with_autoswitch
                fi
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            9)
                local agy_cmd
                agy_cmd=$(get_agy_binary || true)
                if [[ -n "$agy_cmd" ]]; then
                    "$agy_cmd"
                else
                    echo -e "${RED}agy binary tidak ditemukan.${NC}"
                fi
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            10)
                echo ""
                test_notification
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            11)
                echo ""
                echo -n "Path penyimpanan backup (kosongkan untuk default di ~/): "
                read -r dest
                export_accounts "$dest"
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            12)
                echo ""
                echo -n "Masukkan path file backup (.tar.gz): "
                read -r src
                import_accounts "$src"
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            13)
                echo ""
                list_accounts
                echo ""
                echo -n "Masukkan nomor urut, email, atau alias yang ingin dihapus: "
                read -r del_target
                if [[ -n "$del_target" ]]; then
                    remove_account "$del_target"
                fi
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            0|q|Q)
                echo -e "\n${GREEN}Terima kasih telah menggunakan ${APP_NAME}!${NC}"
                exit 0
                ;;
            *)
                echo -e "${RED}Pilihan tidak valid.${NC}"
                sleep 1
                ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# Help Text
# ------------------------------------------------------------------------------
show_help() {
    echo -e "${BLUE}=== 🚀 ${APP_NAME} v${VERSION} ===${NC}"
    echo -e "Multi-Account Manager, Auto-Switcher & Enhancer untuk Google Antigravity CLI di Termux"
    echo ""
    echo -e "${BOLD}Penggunaan:${NC}"
    echo -e "  ${CYAN}gma${NC} [command] [options]"
    echo ""
    echo -e "${BOLD}Perintah Utama:${NC}"
    echo -e "  ${GREEN}menu${NC}                     Buka menu interaktif TUI (default jika tanpa argumen)"
    echo -e "  ${GREEN}list${NC}, ${GREEN}ls${NC}                 Tampilkan semua akun tersimpan beserta alias & model"
    echo -e "  ${GREEN}current${NC}, ${GREEN}whoami${NC}           Tampilkan akun yang sedang aktif"
    echo -e "  ${GREEN}switch${NC} <id|alias|email>  Ganti akun aktif berdasarkan nomor, alias, atau email"
    echo -e "  ${GREEN}next${NC}, ${GREEN}rotate${NC}              Auto-rotate ke akun berikutnya (hanya akun bertanda rotate)"
    echo -e "  ${GREEN}config${NC}, ${GREEN}set${NC} <id|email>     Atur konfigurasi kustom (alias, default model, auto-rotate)"
    echo -e "  ${GREEN}test-notif${NC}               Uji coba notifikasi status bar Termux"
    echo -e "  ${GREEN}add${NC}                      Tambah akun baru (via proses autentikasi Google)"
    echo -e "  ${GREEN}save${NC}                     Simpan akun aktif saat ini ke profil"
    echo -e "  ${GREEN}remove${NC}, ${GREEN}rm${NC} <target>       Hapus akun tersimpan"
    echo -e "  ${GREEN}status${NC}, ${GREEN}quota${NC} [--ping]   Cek masa berlaku token, info akun, & ping API"
    echo -e "  ${GREEN}run${NC}, ${GREEN}exec${NC} <argumen...>     Jalankan agy dengan auto-switch jika limit kuota tercapai"
    echo -e "  ${GREEN}export${NC} [file.tar.gz]     Backup semua profil akun ke file terkompresi"
    echo -e "  ${GREEN}import${NC} <file.tar.gz>     Restore profil akun dari file backup"
    echo -e "  ${GREEN}version${NC}, ${GREEN}-v${NC}               Tampilkan versi GMA"
    echo -e "  ${GREEN}help${NC}, ${GREEN}-h${NC}                  Tampilkan panduan bantuan ini"
    echo ""
    echo -e "${BOLD}Opsi Global:${NC}"
    echo -e "  ${YELLOW}--no-color${NC}               Nonaktifkan warna ANSI"
    echo ""
    echo -e "${BOLD}Contoh:${NC}"
    echo -e "  gma                                  # Buka menu interaktif"
    echo -e "  gma config 1 --alias Kerja           # Beri label alias pada akun #1"
    echo -e "  gma config 1 --model 'Gemini 3.1 Pro (High)' # Atur default model"
    echo -e "  gma switch Kerja                     # Beralih akun langsung via alias"
    echo -e "  gma next                             # Rotasi akun berikutnya"
    echo -e "  gma test-notif                       # Tes notifikasi Termux"
    echo -e "  gma run -p 'Halo agy'                # Eksekusi dengan auto-switch"
}

# ------------------------------------------------------------------------------
# Command Router
# ------------------------------------------------------------------------------
cmd="${1:-menu}"
shift || true

case "$cmd" in
    menu|"") interactive_menu ;;
    list|ls) list_accounts ;;
    current|whoami) current_account ;;
    switch) switch_account "${1:-}" ;;
    next|rotate|auto-switch) next_account ;;
    config|set) config_account "${1:-}" "$@" ;;
    test-notif|notif) test_notification ;;
    add) add_account ;;
    save) save_account ;;
    remove|rm|delete) remove_account "${1:-}" ;;
    status|quota|check) status_account "${1:-}" ;;
    run|exec) run_with_autoswitch "$@" ;;
    export|backup) export_accounts "${1:-}" ;;
    import|restore) import_accounts "${1:-}" ;;
    version|-v|--version) echo -e "${APP_NAME} v${VERSION} (Termux Edition)" ;;
    help|-h|--help) show_help ;;
    *) echo -e "${RED}Perintah tidak dikenal: $cmd${NC}\n"; show_help; exit 1 ;;
esac
