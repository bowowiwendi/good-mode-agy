#!/data/data/com.termux/files/usr/bin/bash
# ==============================================================================
# 🚀 GMA (Good Mode AGY) - v1.3.0
# Multi-Account Manager, True Auto-Switcher & Enhancer for Antigravity CLI on Termux
# ==============================================================================
set -euo pipefail

VERSION="1.3.0"
APP_NAME="GMA (Good Mode AGY)"
GMA_BIN="$(readlink -f "${BASH_SOURCE[0]}")"

# ANSI Colors
if [[ "${1:-}" != "--no-color" && -t 1 ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    BLUE='\033[0;34m'
    MAGENTA='\033[0;35m'
    CYAN='\033[0;36m'
    BOLD='\033[1m'
    NC='\033[0m'
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    MAGENTA=''
    CYAN=''
    BOLD=''
    NC=''
fi

# Flag processing for --no-color
if [[ "${1:-}" == "--no-color" ]]; then
    shift
fi

# Base paths
HOME_DIR="${HOME:-/data/data/com.termux/files/home}"
GEMINI_DIR="$HOME_DIR/.gemini"
AGY_CLI_DIR="$GEMINI_DIR/antigravity-cli"
ACCOUNTS_DIR="$GEMINI_DIR/accounts"
CONFIG_DIR="$GEMINI_DIR/config"
HOOKS_FILE="$CONFIG_DIR/hooks.json"
TMP_DIR="$GEMINI_DIR/tmp"
DAEMON_PID_FILE="$TMP_DIR/gma_daemon.pid"
DAEMON_LOG_FILE="$TMP_DIR/gma_daemon.log"

# Target files
TOKEN_FILE="$AGY_CLI_DIR/antigravity-oauth-token"
CRED_FILE="$GEMINI_DIR/gemini-credentials.json"
GOOGLE_ACC_FILE="$GEMINI_DIR/google_accounts.json"
SETTINGS_FILE="$AGY_CLI_DIR/settings.json"

mkdir -p "$ACCOUNTS_DIR" "$TMP_DIR" "$CONFIG_DIR"

# ------------------------------------------------------------------------------
# Helper: Termux & Terminal Notifications
# ------------------------------------------------------------------------------
send_termux_notification() {
    local title="$1"
    local content="$2"
    local priority="${3:-high}"

    # Non-blocking async background execution for Termux API calls
    (
        if command -v termux-notification &>/dev/null; then
            timeout 1 termux-notification \
                --title "$title" \
                --content "$content" \
                --id "gma_notify" \
                --priority "$priority" \
                --icon "sync" 2>/dev/null || true
        fi

        if command -v termux-toast &>/dev/null; then
            timeout 1 termux-toast "$title: $content" 2>/dev/null || true
        fi
    ) >/dev/null 2>&1 &

    # Terminal Notification Escape sequences (OSC 9 & OSC 777) & Bell
    printf '\e]9;%s: %s\a' "$title" "$content" 2>/dev/null || true
    printf '\a' 2>/dev/null || true
}

# ------------------------------------------------------------------------------
# Helper: Locate real working agy binary (Strictly avoiding self-recursion)
# ------------------------------------------------------------------------------
get_agy_binary() {
    local candidates=(
        "/data/data/com.termux/files/usr/bin/agy"
        "${PREFIX:-/data/data/com.termux/files/usr}/bin/agy"
        "/usr/bin/agy"
        "$HOME_DIR/.local/bin/agy"
    )

    # Search PATH but strictly ignore GMA wrapper or ~/bin/agy
    local p_agy
    while IFS= read -r p_agy; do
        [[ -z "$p_agy" ]] && continue
        candidates+=("$p_agy")
    done < <(which -a agy 2>/dev/null || type -a -p agy 2>/dev/null || true)

    local my_real
    my_real=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "")

    for candidate in "${candidates[@]}"; do
        if [[ -x "$candidate" ]]; then
            local cand_real
            cand_real=$(readlink -f "$candidate" 2>/dev/null || echo "")
            # Never return GMA binary or agy wrapper
            if [[ -n "$my_real" && "$cand_real" == "$my_real" ]]; then
                continue
            fi
            if [[ "$candidate" == "$HOME_DIR/bin/agy" || "$cand_real" == "$HOME_DIR/bin/agy" ]]; then
                continue
            fi
            if [[ "$candidate" == "$HOME_DIR/bin/gma" || "$cand_real" == "$HOME_DIR/bin/gma" ]]; then
                continue
            fi
            # Skip any wrapper script that contains GMA_BIN or calls gma
            if head -n 10 "$candidate" 2>/dev/null | grep -qE "GMA_BIN|gma run|Good Mode AGY"; then
                continue
            fi
            if "$candidate" --version >/dev/null 2>&1 || "$candidate" --help >/dev/null 2>&1; then
                echo "$candidate"
                return 0
            fi
        fi
    done
    return 1
}

# ------------------------------------------------------------------------------
# Helper: Decode JWT Email
# ------------------------------------------------------------------------------
decode_jwt_email() {
    local token="$1"
    local payload
    payload=$(echo "$token" | cut -d'.' -f2)
    local len=$((${#payload} % 4))
    if [ $len -eq 2 ]; then payload="${payload}=="; fi
    if [ $len -eq 3 ]; then payload="${payload}="; fi
    echo "$payload" | base64 -d 2>/dev/null | grep -oP '"email"\s*:\s*"\K[^"]+' || echo "unknown"
}

# ------------------------------------------------------------------------------
# Helper: Get current email
# ------------------------------------------------------------------------------
get_current_email() {
    if [[ -f "$TOKEN_FILE" ]]; then
        if command -v python3 &>/dev/null; then
            local email
            email=$(python3 -c "
import json, base64, sys
try:
    with open('$TOKEN_FILE') as f:
        data = json.load(f)
    id_tok = data.get('id_token', '')
    if id_tok:
        payload = id_tok.split('.')[1]
        payload += '=' * ((4 - len(payload) % 4) % 4)
        dec = json.loads(base64.urlsafe_b64decode(payload.encode()).decode('utf-8', errors='ignore'))
        print(dec.get('email', 'unknown'))
    else:
        print('unknown')
except Exception:
    print('unknown')
" 2>/dev/null || true)
            if [[ -n "$email" && "$email" != "unknown" ]]; then
                echo "$email"
                return
            fi
        fi

        # Fallback to pure bash grep
        local id_token
        id_token=$(grep -oP '"id_token"\s*:\s*"\K[^"]+' "$TOKEN_FILE" 2>/dev/null || true)
        if [[ -n "$id_token" ]]; then
            decode_jwt_email "$id_token"
        else
            echo "unknown"
        fi
    else
        echo "none"
    fi
}

sanitize_email() {
    echo "$1" | sed 's/[^a-zA-Z0-9.-]/_/g'
}

# ------------------------------------------------------------------------------
# Helper: Get all saved accounts as an array
# Output format per line: email|dir|alias|model|auto_rotate
# ------------------------------------------------------------------------------
get_saved_accounts() {
    if [[ ! -d "$ACCOUNTS_DIR" ]]; then
        return
    fi

    if command -v python3 &>/dev/null; then
        python3 -c "
import os, json, sys

accounts_dir = '$ACCOUNTS_DIR'
items = []
if os.path.exists(accounts_dir):
    for name in os.listdir(accounts_dir):
        dir_path = os.path.join(accounts_dir, name)
        if os.path.isdir(dir_path):
            meta_path = os.path.join(dir_path, 'meta.json')
            email, alias, model, auto_rotate = 'unknown', '', '', 'true'
            if os.path.exists(meta_path):
                try:
                    with open(meta_path) as f:
                        meta = json.load(f)
                    email = meta.get('email', 'unknown')
                    alias = meta.get('alias', '')
                    model = meta.get('model', '')
                    auto_rotate = 'true' if meta.get('auto_rotate', True) else 'false'
                except Exception:
                    pass
            if email != 'unknown':
                items.append((email, dir_path, alias, model, auto_rotate))

items.sort(key=lambda x: x[0])
for email, dir_path, alias, model, auto_rotate in items:
    print(f'{email}|{dir_path}|{alias}|{model}|{auto_rotate}')
" 2>/dev/null || true
    else
        # Pure bash fallback
        for dir in "$ACCOUNTS_DIR"/*; do
            if [[ -d "$dir" ]]; then
                local meta_email="unknown"
                local alias=""
                local model=""
                local auto_rotate="true"
                if [[ -f "$dir/meta.json" ]]; then
                    meta_email=$(grep -oP '"email"\s*:\s*"\K[^"]+' "$dir/meta.json" 2>/dev/null || echo "unknown")
                    alias=$(grep -oP '"alias"\s*:\s*"\K[^"]+' "$dir/meta.json" 2>/dev/null || true)
                    model=$(grep -oP '"model"\s*:\s*"\K[^"]+' "$dir/meta.json" 2>/dev/null || true)
                fi
                if [[ "$meta_email" != "unknown" ]]; then
                    echo "$meta_email|$dir|$alias|$model|$auto_rotate"
                fi
            fi
        done | sort
    fi
}

# ------------------------------------------------------------------------------
# Helper: Read account metadata
# ------------------------------------------------------------------------------
get_account_meta() {
    local target_email="$1"
    local safe_email
    safe_email=$(sanitize_email "$target_email")
    local meta_path="$ACCOUNTS_DIR/$safe_email/meta.json"
    if [[ -f "$meta_path" ]] && command -v python3 &>/dev/null; then
        python3 -c "
import json
with open('$meta_path') as f:
    d = json.load(f)
print(f\"{d.get('alias','')}|{d.get('model','')}|{d.get('effort','')}|{d.get('auto_rotate', True)}|{d.get('notes','')}\")
" 2>/dev/null || echo "|||True|"
    else
        echo "|||True|"
    fi
}

# ------------------------------------------------------------------------------
# Helper: Save account metadata
# ------------------------------------------------------------------------------
update_account_meta() {
    local target_email="$1"
    local key="$2"
    local value="$3"
    local safe_email
    safe_email=$(sanitize_email "$target_email")
    local prof_dir="$ACCOUNTS_DIR/$safe_email"
    mkdir -p "$prof_dir"
    local meta_path="$prof_dir/meta.json"

    if command -v python3 &>/dev/null; then
        python3 -c "
import json, os, datetime

meta_path = '$meta_path'
data = {'email': '$target_email'}
if os.path.exists(meta_path):
    try:
        with open(meta_path) as f:
            data = json.load(f)
    except Exception:
        pass

val = '$value'
if '$key' == 'auto_rotate':
    data['$key'] = (val.lower() in ('true', '1', 'yes', 'on'))
else:
    data['$key'] = val

data['updated_at'] = datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')

with open(meta_path, 'w') as f:
    json.dump(data, f, indent=2)
"
    fi
}

# ------------------------------------------------------------------------------
# Command: list
# ------------------------------------------------------------------------------
list_accounts() {
    local current
    current=$(get_current_email)
    echo -e "${BLUE}=== 🚀 ${APP_NAME} v${VERSION} - Accounts ===${NC}"
    
    local accounts=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && accounts+=("$line")
    done < <(get_saved_accounts)

    if [[ ${#accounts[@]} -eq 0 ]]; then
        echo -e "${YELLOW}Belum ada akun yang tersimpan.${NC}"
        echo "Gunakan 'gma save' untuk menyimpan akun aktif, atau 'gma add' untuk menambah akun baru."
    else
        local idx=1
        for acc in "${accounts[@]}"; do
            local email
            local alias
            local model
            local auto_rot
            email=$(echo "$acc" | cut -d'|' -f1)
            alias=$(echo "$acc" | cut -d'|' -f3)
            model=$(echo "$acc" | cut -d'|' -f4)
            auto_rot=$(echo "$acc" | cut -d'|' -f5)

            local marker="  "
            if [[ "$email" == "$current" && "$current" != "none" ]]; then
                marker="${GREEN}* ${NC}"
            fi

            local alias_str=""
            if [[ -n "$alias" ]]; then
                alias_str=" ${MAGENTA}[${alias}]${NC}"
            fi

            local model_str=""
            if [[ -n "$model" ]]; then
                model_str=" ${CYAN}(${model})${NC}"
            fi

            local rot_str=""
            if [[ "$auto_rot" == "false" ]]; then
                rot_str=" ${YELLOW}[No-Rotate]${NC}"
            fi

            echo -e "${marker}${BOLD}${idx}.${NC} ${email}${alias_str}${model_str}${rot_str}"
            idx=$((idx + 1))
        done
    fi
    
    echo ""
    if [[ "$current" == "none" ]]; then
        echo -e "${YELLOW}Status: Tidak ada akun yang aktif saat ini.${NC}"
    else
        local found=0
        for acc in "${accounts[@]}"; do
            if [[ "${acc%%|*}" == "$current" ]]; then
                found=1
                break
            fi
        done
        if [[ $found -eq 1 ]]; then
            echo -e "Akun Aktif: ${GREEN}${BOLD}$current${NC}"
        else
            echo -e "Akun Aktif: ${GREEN}${BOLD}$current${NC} ${YELLOW}(belum disimpan ke profil, gunakan 'gma save')${NC}"
        fi
    fi
}

# ------------------------------------------------------------------------------
# Command: current
# ------------------------------------------------------------------------------
current_account() {
    local email
    email=$(get_current_email)
    if [[ "$email" == "none" ]]; then
        echo -e "${YELLOW}Tidak ada akun aktif.${NC}"
    else
        local meta
        meta=$(get_account_meta "$email")
        local alias
        alias=$(echo "$meta" | cut -d'|' -f1)
        local model
        model=$(echo "$meta" | cut -d'|' -f2)

        local extra=""
        [[ -n "$alias" ]] && extra+=" [Alias: $alias]"
        [[ -n "$model" ]] && extra+=" [Model: $model]"
        echo -e "Akun Aktif: ${GREEN}${BOLD}$email${NC}${CYAN}$extra${NC}"
    fi
}

# ------------------------------------------------------------------------------
# Internal helper: Backup current active credentials
# ------------------------------------------------------------------------------
backup_current() {
    local email
    email=$(get_current_email)
    if [[ "$email" != "none" && "$email" != "unknown" ]]; then
        local safe_email
        safe_email=$(sanitize_email "$email")
        local prof_dir="$ACCOUNTS_DIR/$safe_email"
        mkdir -p "$prof_dir"
        
        [[ -f "$TOKEN_FILE" ]] && cp -p "$TOKEN_FILE" "$prof_dir/oauth-token"
        [[ -f "$CRED_FILE" ]] && cp -p "$CRED_FILE" "$prof_dir/credentials.json"
        [[ -f "$GOOGLE_ACC_FILE" ]] && cp -p "$GOOGLE_ACC_FILE" "$prof_dir/google_accounts.json"
        [[ -f "$SETTINGS_FILE" ]] && cp -p "$SETTINGS_FILE" "$prof_dir/settings.json"
        
        # Preserve existing meta fields (alias, model, etc)
        local meta_file="$prof_dir/meta.json"
        if [[ -f "$meta_file" ]] && command -v python3 &>/dev/null; then
            python3 -c "
import json, datetime
try:
    with open('$meta_file') as f:
        d = json.load(f)
except Exception:
    d = {}
d['email'] = '$email'
d['updated_at'] = datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
with open('$meta_file', 'w') as f:
    json.dump(d, f, indent=2)
"
        else
            local now
            now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
            echo "{\"email\":\"$email\",\"updated_at\":\"$now\"}" > "$meta_file"
        fi
    fi
}

# ------------------------------------------------------------------------------
# Command: save
# ------------------------------------------------------------------------------
save_account() {
    local email
    email=$(get_current_email)
    if [[ "$email" == "none" || "$email" == "unknown" ]]; then
        echo -e "${RED}Gagal menyimpan: Tidak ada akun aktif atau token tidak valid.${NC}"
        exit 1
    fi
    backup_current
    echo -e "${GREEN}✓ Akun '${email}' berhasil disimpan ke profil.${NC}"
}

# ------------------------------------------------------------------------------
# Command: switch
# ------------------------------------------------------------------------------
switch_account() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        echo -e "${RED}Error: Masukkan nomor urut (index), alias, atau email akun yang ingin digunakan.${NC}"
        echo -e "Contoh: ${CYAN}gma switch 1${NC} atau ${CYAN}gma switch primary${NC} atau ${CYAN}gma switch user@gmail.com${NC}"
        exit 1
    fi

    local accounts=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && accounts+=("$line")
    done < <(get_saved_accounts)

    if [[ ${#accounts[@]} -eq 0 ]]; then
        echo -e "${RED}Tidak ada akun tersimpan. Gunakan 'gma add' terlebih dahulu.${NC}"
        exit 1
    fi

    local target_dir=""
    local target_email=""
    local target_alias=""
    local target_model=""
    
    local idx=1
    for acc in "${accounts[@]}"; do
        local email
        local dir
        local alias
        local model
        email=$(echo "$acc" | cut -d'|' -f1)
        dir=$(echo "$acc" | cut -d'|' -f2)
        alias=$(echo "$acc" | cut -d'|' -f3)
        model=$(echo "$acc" | cut -d'|' -f4)

        if [[ "$target" == "$email" || "$target" == "$idx" || ( -n "$alias" && "${target,,}" == "${alias,,}" ) ]]; then
            target_dir="$dir"
            target_email="$email"
            target_alias="$alias"
            target_model="$model"
            break
        fi
        idx=$((idx + 1))
    done
    
    if [[ -z "$target_dir" ]]; then
        echo -e "${RED}Akun '$target' tidak ditemukan di profil tersimpan.${NC}"
        echo -e "Jalankan ${CYAN}gma list${NC} untuk melihat daftar akun yang tersedia."
        exit 1
    fi
    
    local disp_name="$target_email"
    [[ -n "$target_alias" ]] && disp_name="$target_email [$target_alias]"
    echo -e "${BLUE}Mengganti akun aktif ke: ${BOLD}$disp_name${NC}..."
    
    # Backup current session before switching
    backup_current
    
    # Copy target profile to active files
    mkdir -p "$(dirname "$TOKEN_FILE")"
    
    if [[ -f "$target_dir/oauth-token" ]]; then
        cp -p "$target_dir/oauth-token" "$TOKEN_FILE"
        chmod 600 "$TOKEN_FILE"
    fi
    
    if [[ -f "$target_dir/credentials.json" ]]; then
        cp -p "$target_dir/credentials.json" "$CRED_FILE"
        chmod 600 "$CRED_FILE"
    else
        rm -f "$CRED_FILE"
    fi

    if [[ -f "$target_dir/settings.json" ]]; then
        cp -p "$target_dir/settings.json" "$SETTINGS_FILE"
    fi
    
    if [[ -f "$target_dir/google_accounts.json" ]]; then
        cp -p "$target_dir/google_accounts.json" "$GOOGLE_ACC_FILE"
    else
        echo "{\"active\": null, \"old\": [\"$target_email\"]}" > "$GOOGLE_ACC_FILE"
    fi

    # Apply per-account custom model to settings.json if configured
    if [[ -n "$target_model" && -f "$SETTINGS_FILE" ]] && command -v python3 &>/dev/null; then
        python3 -c "
import json
try:
    with open('$SETTINGS_FILE') as f:
        s = json.load(f)
    s['model'] = '$target_model'
    with open('$SETTINGS_FILE', 'w') as f:
        json.dump(s, f, indent=2)
except Exception:
    pass
" 2>/dev/null || true
        echo -e "✓ Model otomatis diatur ke: ${CYAN}${target_model}${NC}"
    fi
    
    echo -e "${GREEN}✓ Berhasil beralih ke: ${BOLD}$disp_name${NC}"

    # Termux notification
    send_termux_notification "🚀 GMA: Akun Aktif Berganti" "Beralih ke: $disp_name" "high"
}

# ------------------------------------------------------------------------------
# Command: next (Auto-switch / Rotate to next account)
# ------------------------------------------------------------------------------
next_account() {
    local accounts=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && accounts+=("$line")
    done < <(get_saved_accounts)

    local total=${#accounts[@]}
    if [[ $total -le 1 ]]; then
        echo -e "${YELLOW}Hanya ada $total akun tersimpan. Tambah akun lain dengan 'gma add' untuk rotasi.${NC}"
        return 0
    fi

    # Filter accounts enabled for auto-rotation
    local rot_accounts=()
    for acc in "${accounts[@]}"; do
        local auto_rot
        auto_rot=$(echo "$acc" | cut -d'|' -f5)
        if [[ "$auto_rot" != "false" ]]; then
            rot_accounts+=("$acc")
        fi
    done

    if [[ ${#rot_accounts[@]} -eq 0 ]]; then
        echo -e "${YELLOW}Semua akun dinonaktifkan dari auto-rotate. Menggunakan seluruh akun tersimpan...${NC}"
        rot_accounts=("${accounts[@]}")
    fi

    local rot_total=${#rot_accounts[@]}
    local current
    current=$(get_current_email)
    local current_rot_idx=0

    for i in "${!rot_accounts[@]}"; do
        local acc_email
        acc_email=$(echo "${rot_accounts[$i]}" | cut -d'|' -f1)
        if [[ "$acc_email" == "$current" ]]; then
            current_rot_idx=$((i + 1))
            break
        fi
    done

    # Next index with round-robin wrap around
    local next_rot_idx=$(( (current_rot_idx % rot_total) + 1 ))
    local next_acc="${rot_accounts[$((next_rot_idx - 1))]}"
    local next_email
    local next_alias
    next_email=$(echo "$next_acc" | cut -d'|' -f1)
    next_alias=$(echo "$next_acc" | cut -d'|' -f3)

    local disp_target="$next_email"
    [[ -n "$next_alias" ]] && disp_target="$next_email [$next_alias]"

    echo -e "${CYAN}🔄 [Auto-Rotate] Beralih ke (${next_rot_idx}/${rot_total}): ${BOLD}${disp_target}${NC}"
    switch_account "$next_email" >/dev/null
    echo -e "${GREEN}✓ Akun aktif sekarang: ${BOLD}${disp_target}${NC} (${next_rot_idx}/${rot_total})"

    # Termux notification
    send_termux_notification "🔄 GMA Auto-Switch" "Akun aktif sekarang: $disp_target" "high"
}

# ------------------------------------------------------------------------------
# Command: config / set (Configure per-account settings)
# ------------------------------------------------------------------------------
config_account() {
    local target="${1:-}"

    if [[ -z "$target" ]]; then
        # Interactive account selection for config
        list_accounts
        echo ""
        echo -n "Masukkan nomor urut, email, atau alias akun yang ingin dikonfigurasi: "
        read -r target
        if [[ -z "$target" ]]; then
            echo "Dibatalkan."
            return 0
        fi
    fi

    # Find account
    local accounts=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && accounts+=("$line")
    done < <(get_saved_accounts)

    local target_email=""
    local idx=1
    for acc in "${accounts[@]}"; do
        local email
        local alias
        email=$(echo "$acc" | cut -d'|' -f1)
        alias=$(echo "$acc" | cut -d'|' -f3)
        if [[ "$target" == "$email" || "$target" == "$idx" || ( -n "$alias" && "${target,,}" == "${alias,,}" ) ]]; then
            target_email="$email"
            break
        fi
        idx=$((idx + 1))
    done

    if [[ -z "$target_email" ]]; then
        echo -e "${RED}Akun '$target' tidak ditemukan.${NC}"
        return 1
    fi

    shift || true

    # Check for CLI flags: --alias, --model, --effort, --rotate, --notes
    local new_alias=""
    local new_model=""
    local new_effort=""
    local new_rotate=""
    local new_notes=""
    local has_flags=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --alias) new_alias="$2"; has_flags=1; shift 2 ;;
            --model) new_model="$2"; has_flags=1; shift 2 ;;
            --effort) new_effort="$2"; has_flags=1; shift 2 ;;
            --rotate) new_rotate="$2"; has_flags=1; shift 2 ;;
            --notes) new_notes="$2"; has_flags=1; shift 2 ;;
            *) shift ;;
        esac
    done

    if [[ $has_flags -eq 1 ]]; then
        [[ -n "$new_alias" ]] && update_account_meta "$target_email" "alias" "$new_alias"
        [[ -n "$new_model" ]] && update_account_meta "$target_email" "model" "$new_model"
        [[ -n "$new_effort" ]] && update_account_meta "$target_email" "effort" "$new_effort"
        [[ -n "$new_rotate" ]] && update_account_meta "$target_email" "auto_rotate" "$new_rotate"
        [[ -n "$new_notes" ]] && update_account_meta "$target_email" "notes" "$new_notes"
        echo -e "${GREEN}✓ Konfigurasi akun ${BOLD}$target_email${NC}${GREEN} berhasil diperbarui!${NC}"
        return 0
    fi

    # Interactive Configuration Wizard
    local meta
    meta=$(get_account_meta "$target_email")
    local cur_alias
    local cur_model
    local cur_effort
    local cur_rotate
    local cur_notes
    cur_alias=$(echo "$meta" | cut -d'|' -f1)
    cur_model=$(echo "$meta" | cut -d'|' -f2)
    cur_effort=$(echo "$meta" | cut -d'|' -f3)
    cur_rotate=$(echo "$meta" | cut -d'|' -f4)
    cur_notes=$(echo "$meta" | cut -d'|' -f5)

    echo ""
    echo -e "${BLUE}=== ⚙️  Konfigurasi Kustom Akun ===${NC}"
    echo -e "Akun: ${GREEN}${BOLD}$target_email${NC}"
    echo "------------------------------------------------------------"
    
    # 1. Alias
    echo -e "Alias / Label saat ini: ${MAGENTA}${cur_alias:-[Belum diatur]}${NC}"
    echo -n "Masukkan alias baru (tekan Enter untuk tidak mengubah, '-' untuk hapus): "
    read -r inp_alias
    if [[ "$inp_alias" == "-" ]]; then
        update_account_meta "$target_email" "alias" ""
        echo "  ✓ Alias dihapus."
    elif [[ -n "$inp_alias" ]]; then
        update_account_meta "$target_email" "alias" "$inp_alias"
        echo "  ✓ Alias diatur ke: $inp_alias"
    fi

    # 2. Model
    echo ""
    echo -e "Default Model saat ini: ${CYAN}${cur_model:-[Bawaan Sistem]}${NC}"
    echo "Pilihan model populer:"
    echo "  1) Gemini 3.8 Flash (High)"
    echo "  2) Gemini 3.8 Flash (Medium)"
    echo "  3) Gemini 3.7 Flash (High)"
    echo "  4) Gemini 3.1 Pro (High)"
    echo "  5) Claude Sonnet 4.6 (Thinking)"
    echo "  6) Custom input"
    echo "  0) Hapus custom model (gunakan default AGY)"
    echo -n "Pilih opsi [0-6, Enter untuk lewati]: "
    read -r inp_mod_opt
    case "$inp_mod_opt" in
        1) update_account_meta "$target_email" "model" "Gemini 3.8 Flash (High)"; echo "  ✓ Model diatur ke: Gemini 3.8 Flash (High)" ;;
        2) update_account_meta "$target_email" "model" "Gemini 3.8 Flash (Medium)"; echo "  ✓ Model diatur ke: Gemini 3.8 Flash (Medium)" ;;
        3) update_account_meta "$target_email" "model" "Gemini 3.7 Flash (High)"; echo "  ✓ Model diatur ke: Gemini 3.7 Flash (High)" ;;
        4) update_account_meta "$target_email" "model" "Gemini 3.1 Pro (High)"; echo "  ✓ Model diatur ke: Gemini 3.1 Pro (High)" ;;
        5) update_account_meta "$target_email" "model" "Claude Sonnet 4.6 (Thinking)"; echo "  ✓ Model diatur ke: Claude Sonnet 4.6 (Thinking)" ;;
        6) 
            echo -n "Masukkan nama model persis: "
            read -r custom_m
            [[ -n "$custom_m" ]] && update_account_meta "$target_email" "model" "$custom_m"
            ;;
        0) update_account_meta "$target_email" "model" ""; echo "  ✓ Custom model dihapus." ;;
        *) ;;
    esac

    # 3. Auto-Rotate Toggle
    echo ""
    local rot_disp="Aktif"
    [[ "$cur_rotate" == "False" || "$cur_rotate" == "false" ]] && rot_disp="Nonaktif"
    echo -e "Status Auto-Rotate saat ini: ${YELLOW}$rot_disp${NC}"
    echo -n "Sertakan akun ini dalam rotasi otomatis saat kuota habis? (y/n, Enter untuk lewati): "
    read -r inp_rot
    if [[ "$inp_rot" =~ ^[Yy]$ ]]; then
        update_account_meta "$target_email" "auto_rotate" "true"
        echo "  ✓ Auto-rotate diaktifkan untuk akun ini."
    elif [[ "$inp_rot" =~ ^[Nn]$ ]]; then
        update_account_meta "$target_email" "auto_rotate" "false"
        echo "  ✓ Auto-rotate dinonaktifkan (akun tidak akan tersentuh saat rotasi otomatis)."
    fi

    # 4. Notes
    echo ""
    echo -e "Catatan saat ini: ${cur_notes:-[Kosong]}"
    echo -n "Catatan baru (tekan Enter untuk lewati, '-' untuk hapus): "
    read -r inp_notes
    if [[ "$inp_notes" == "-" ]]; then
        update_account_meta "$target_email" "notes" ""
    elif [[ -n "$inp_notes" ]]; then
        update_account_meta "$target_email" "notes" "$inp_notes"
    fi

    echo ""
    echo -e "${GREEN}✓ Konfigurasi akun ${BOLD}$target_email${NC}${GREEN} selesai disimpan!${NC}"
}

# ------------------------------------------------------------------------------
# Command: test-notif
# ------------------------------------------------------------------------------
test_notification() {
    echo -e "${BLUE}=== 🔔 Menguji Notifikasi Termux ===${NC}"
    
    local has_termux_api=0
    if command -v termux-notification &>/dev/null; then
        has_termux_api=1
        echo -e "${GREEN}✓ Paket 'termux-api' ditemukan di Termux.${NC}"
    else
        echo -e "${YELLOW}ℹ️  'termux-notification' belum terpasang.${NC}"
        echo -e "Agar notifikasi pop-up muncul di status bar Android, jalankan:"
        echo -e "  ${CYAN}pkg install termux-api${NC}"
        echo -e "Dan instal aplikasi pendamping ${BOLD}Termux:API${NC} dari F-Droid atau GitHub."
        echo ""
    fi

    send_termux_notification "🚀 GMA (Good Mode AGY)" "Uji coba notifikasi Termux berhasil! Sistem Auto-Switch GMA siap beroperasi." "high"
    echo -e "${GREEN}✓ Sinyal notifikasi telah dikirimkan!${NC}"
}

# ------------------------------------------------------------------------------
# Command: add
# ------------------------------------------------------------------------------
add_account() {
    echo -e "${BLUE}=== 🚀 ${APP_NAME} - Tambah Akun Baru ===${NC}"
    echo -e "${YELLOW}Proses ini akan menjalankan otentikasi Google untuk akun baru.${NC}"
    echo ""

    local AGY_BIN
    if ! AGY_BIN=$(get_agy_binary); then
        echo -e "${RED}Error: Binary 'agy' yang dapat dieksekusi tidak ditemukan.${NC}"
        exit 1
    fi

    # Backup current account first
    local current_email
    current_email=$(get_current_email)
    if [[ "$current_email" != "none" && "$current_email" != "unknown" ]]; then
        echo -e "Menyimpan akun saat ini (${GREEN}$current_email${NC}) terlebih dahulu..."
        backup_current
        echo -e "${GREEN}✓ Akun saat ini aman dibackup.${NC}"
    fi

    local tmp_backup="$TMP_DIR/agy_auth_$$"
    mkdir -p "$tmp_backup"

    # Temporarily move active credentials
    [[ -f "$TOKEN_FILE" ]] && mv "$TOKEN_FILE" "$tmp_backup/"
    [[ -f "$CRED_FILE" ]] && mv "$CRED_FILE" "$tmp_backup/"

    cleanup_on_interrupt() {
        echo -e "\n${YELLOW}Operasi dibatalkan. Mengembalikan akun sebelumnya...${NC}"
        [[ -f "$tmp_backup/antigravity-oauth-token" && ! -f "$TOKEN_FILE" ]] && mv "$tmp_backup/antigravity-oauth-token" "$TOKEN_FILE"
        [[ -f "$tmp_backup/gemini-credentials.json" && ! -f "$CRED_FILE" ]] && mv "$tmp_backup/gemini-credentials.json" "$CRED_FILE"
        rm -rf "$tmp_backup"
        exit 130
    }
    trap cleanup_on_interrupt INT TERM

    echo ""
    echo -e "${BLUE}=== Memulai Autentikasi Google ===${NC}"
    echo -e "${YELLOW}1. Buka URL yang ditampilkan di browser.${NC}"
    echo -e "${YELLOW}2. Selesaikan login Google dengan akun yang baru.${NC}"
    echo -e "${YELLOW}3. Jika kode otorisasi diberikan, salin dan tempel di sini, lalu tekan Enter.${NC}"
    echo ""

    local agy_exit=0
    "$AGY_BIN" --print "." || agy_exit=$?

    if [[ ! -f "$TOKEN_FILE" ]]; then
        echo ""
        echo -e "${RED}Autentikasi gagal, dibatalkan, atau waktu habis.${NC}"
        [[ -f "$tmp_backup/antigravity-oauth-token" ]] && mv "$tmp_backup/antigravity-oauth-token" "$TOKEN_FILE"
        [[ -f "$tmp_backup/gemini-credentials.json" ]] && mv "$tmp_backup/gemini-credentials.json" "$CRED_FILE"
        rm -rf "$tmp_backup"
        trap - INT TERM
        exit 1
    fi

    local new_email
    new_email=$(get_current_email)
    if [[ "$new_email" == "none" || "$new_email" == "unknown" ]]; then
        echo -e "${RED}Gagal membaca email dari login baru.${NC}"
        [[ -f "$tmp_backup/antigravity-oauth-token" ]] && mv "$tmp_backup/antigravity-oauth-token" "$TOKEN_FILE"
        [[ -f "$tmp_backup/gemini-credentials.json" ]] && mv "$tmp_backup/gemini-credentials.json" "$CRED_FILE"
        rm -rf "$tmp_backup"
        trap - INT TERM
        exit 1
    fi

    if [[ "$new_email" == "$current_email" ]]; then
        echo -e "${YELLOW}Peringatan: Anda login dengan akun yang sama ($new_email). Tidak ada akun baru yang ditambahkan.${NC}"
        rm -rf "$tmp_backup"
        trap - INT TERM
        exit 0
    fi

    echo -e "${GREEN}✓ Berhasil login dengan akun: ${BOLD}$new_email${NC}"
    backup_current
    echo -e "${GREEN}✓ Akun baru berhasil disimpan ke profil GMA!${NC}"

    echo ""
    echo -n "Beri alias/nama panggilan untuk akun ini (kosongkan jika tidak ada): "
    read -r quick_alias
    if [[ -n "$quick_alias" ]]; then
        update_account_meta "$new_email" "alias" "$quick_alias"
        echo -e "${GREEN}✓ Alias '${quick_alias}' disimpan.${NC}"
    fi

    echo ""
    echo -e "Gunakan ${CYAN}gma switch <nomor|email|alias>${NC} atau ${CYAN}gma next${NC} untuk beralih akun."
    
    send_termux_notification "🚀 GMA: Akun Baru Ditambahkan" "Akun $new_email siap digunakan." "default"

    trap - INT TERM
    rm -rf "$tmp_backup"
}

# ------------------------------------------------------------------------------
# Command: remove
# ------------------------------------------------------------------------------
remove_account() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        echo -e "${RED}Error: Masukkan email, nomor akun, atau alias yang ingin dihapus.${NC}"
        exit 1
    fi
    
    local accounts=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && accounts+=("$line")
    done < <(get_saved_accounts)

    local target_dir=""
    local target_email=""
    
    local idx=1
    for acc in "${accounts[@]}"; do
        local email
        local dir
        local alias
        email=$(echo "$acc" | cut -d'|' -f1)
        dir=$(echo "$acc" | cut -d'|' -f2)
        alias=$(echo "$acc" | cut -d'|' -f3)
        if [[ "$target" == "$email" || "$target" == "$idx" || ( -n "$alias" && "${target,,}" == "${alias,,}" ) ]]; then
            target_dir="$dir"
            target_email="$email"
            break
        fi
        idx=$((idx + 1))
    done
    
    if [[ -z "$target_dir" ]]; then
        echo -e "${RED}Akun '$target' tidak ditemukan.${NC}"
        exit 1
    fi
    
    echo -e "${YELLOW}Apakah Anda yakin ingin menghapus profil akun ${BOLD}$target_email${NC}${YELLOW}? (y/N)${NC}"
    read -r confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        local current_email
        current_email=$(get_current_email)
        rm -rf "$target_dir"
        if [[ "$target_email" == "$current_email" ]]; then
            rm -f "$TOKEN_FILE" "$CRED_FILE"
            echo -e "${YELLOW}Sesi aktif telah dihapus karena akun yang dihapus sedang aktif.${NC}"
        fi
        echo -e "${GREEN}✓ Akun $target_email berhasil dihapus.${NC}"
    else
        echo "Dibatalkan."
    fi
}

# ------------------------------------------------------------------------------
# Command: status (Inspect token, expiry, and connectivity)
# ------------------------------------------------------------------------------
status_account() {
    local do_ping=0
    if [[ "${1:-}" == "--ping" || "${1:-}" == "-p" ]]; then
        do_ping=1
    fi

    echo -e "${BLUE}=== 🚀 ${APP_NAME} v${VERSION} - Status & Token Inspection ===${NC}"
    local current
    current=$(get_current_email)

    if [[ "$current" == "none" ]]; then
        echo -e "Akun Aktif     : ${YELLOW}Tidak ada (Silakan login atau 'gma switch')${NC}"
    else
        local meta
        meta=$(get_account_meta "$current")
        local alias
        local model
        alias=$(echo "$meta" | cut -d'|' -f1)
        model=$(echo "$meta" | cut -d'|' -f2)
        local extra=""
        [[ -n "$alias" ]] && extra+=" [Alias: $alias]"
        [[ -n "$model" ]] && extra+=" [Model: $model]"
        echo -e "Akun Aktif     : ${GREEN}${BOLD}$current${NC}${CYAN}$extra${NC}"
    fi

    # Check Daemon status
    local daemon_running=0
    if [[ -f "$DAEMON_PID_FILE" ]]; then
        local dpid
        dpid=$(cat "$DAEMON_PID_FILE" 2>/dev/null || echo "")
        if [[ -n "$dpid" ]] && kill -0 "$dpid" 2>/dev/null; then
            daemon_running=1
        fi
    fi
    if [[ $daemon_running -eq 1 ]]; then
        echo -e "Daemon Watcher : ${GREEN}Aktif di Latar Belakang (PID: $(cat "$DAEMON_PID_FILE"))${NC}"
    else
        echo -e "Daemon Watcher : ${YELLOW}Nonaktif ('gma daemon start' untuk mengaktifkan)${NC}"
    fi

    # Check Wrapper status
    if [[ -x "$HOME_DIR/bin/agy" ]]; then
        echo -e "Wrapper agy    : ${GREEN}Terpasang di ~/bin/agy (Auto-Switch Siap)${NC}"
    else
        echo -e "Wrapper agy    : ${YELLOW}Belum Terpasang ('gma wrapper install' untuk memasang)${NC}"
    fi

    if [[ -f "$TOKEN_FILE" ]]; then
        echo -e "File Token     : ${GREEN}Tersedia${NC} (${TOKEN_FILE})"
        if command -v python3 &>/dev/null; then
            python3 -c "
import json, sys
from datetime import datetime, timezone

try:
    with open('$TOKEN_FILE') as f:
        data = json.load(f)
    tok = data.get('token', {})
    expiry_str = tok.get('expiry', '')
    has_refresh = 'Ya' if tok.get('refresh_token') else 'Tidak'
    print(f'Refresh Token  : \033[0;32m{has_refresh}\033[0m (Auto-refresh token siap)')
    
    if expiry_str:
        clean_str = expiry_str.split('.')[0] + 'Z' if '.' in expiry_str else expiry_str
        exp_dt = datetime.strptime(clean_str, '%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=timezone.utc)
        now_dt = datetime.now(timezone.utc)
        diff = int((exp_dt - now_dt).total_seconds())
        if diff > 0:
            mins = diff // 60
            hrs = mins // 60
            remaining = f'{hrs}j {mins % 60}m' if hrs > 0 else f'{mins}m'
            print(f'Masa Token     : \033[0;32mValid\033[0m (berlaku ~{remaining} lagi)')
        else:
            print('Masa Token     : \033[0;33mKedaluwarsa (akan di-refresh otomatis oleh AGY)\033[0m')
except Exception as e:
    print('Masa Token     : \033[0;33mTidak dapat dianalisis\033[0m')
" 2>/dev/null || true
        fi
    else
        echo -e "File Token     : ${RED}Tidak ditemukan${NC}"
    fi

    # Saved accounts summary
    local accounts=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && accounts+=("$line")
    done < <(get_saved_accounts)

    echo ""
    echo -e "${BLUE}Daftar Akun Tersimpan (${#accounts[@]} Akun):${NC}"
    local idx=1
    for acc in "${accounts[@]}"; do
        local email
        local dir
        local alias
        local model
        local auto_rot
        email=$(echo "$acc" | cut -d'|' -f1)
        dir=$(echo "$acc" | cut -d'|' -f2)
        alias=$(echo "$acc" | cut -d'|' -f3)
        model=$(echo "$acc" | cut -d'|' -f4)
        auto_rot=$(echo "$acc" | cut -d'|' -f5)

        local mark="  "
        if [[ "$email" == "$current" ]]; then
            mark="${GREEN}* ${NC}"
        fi
        local has_tok="[No Token]"
        if [[ -f "$dir/oauth-token" ]]; then
            has_tok="${GREEN}[Siap]${NC}"
        fi

        local details=""
        [[ -n "$alias" ]] && details+=" ${MAGENTA}[$alias]${NC}"
        [[ -n "$model" ]] && details+=" ${CYAN}($model)${NC}"
        [[ "$auto_rot" == "false" ]] && details+=" ${YELLOW}[No-Rotate]${NC}"

        echo -e "${mark}${BOLD}${idx}.${NC} ${email} ${has_tok}${details}"
        idx=$((idx + 1))
    done

    if [[ $do_ping -eq 1 ]]; then
        echo ""
        echo -e "${BLUE}Mengecek konektivitas API dengan Google Antigravity...${NC}"
        local AGY_BIN
        if AGY_BIN=$(get_agy_binary); then
            if "$AGY_BIN" models >/dev/null 2>&1; then
                echo -e "${GREEN}✓ Koneksi API berhasil & kuota akun aktif tersedia!${NC}"
            else
                echo -e "${RED}✗ Gagal menghubungi API atau kuota akun habis.${NC}"
            fi
        fi
    fi
}

# ------------------------------------------------------------------------------
# Command: run (Execute agy with 100% Automatic Auto-Switch on Quota Exceeded)
# ------------------------------------------------------------------------------
run_with_autoswitch() {
    local AGY_BIN
    if ! AGY_BIN=$(get_agy_binary); then
        echo -e "${RED}Error: Binary 'agy' asli tidak ditemukan di sistem.${NC}"
        exit 1
    fi

    # Support --raw flag to bypass auto-switch
    if [[ "${1:-}" == "--raw" ]]; then
        shift
        exec "$AGY_BIN" "$@"
    fi

    # Pass-through informational commands directly without wrapper intervention
    for arg in "$@"; do
        case "$arg" in
            --version|-v|version|--help|-h|help|models|agents|changelog)
                exec "$AGY_BIN" "$@"
                ;;
        esac
    done

    local accounts=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && accounts+=("$line")
    done < <(get_saved_accounts)

    local total_accounts=${#accounts[@]}
    local max_attempts=$(( total_accounts > 0 ? total_accounts : 1 ))
    local attempt=${GMA_SWITCH_ATTEMPT:-1}

    # If single account or no accounts, run agy directly
    if [[ $total_accounts -le 1 ]]; then
        exec "$AGY_BIN" "$@"
    fi

    # Check if this invocation is batch/print mode
    local is_batch=0
    for arg in "$@"; do
        if [[ "$arg" == "-p" || "$arg" == "--print" || "$arg" == "--prompt" ]]; then
            is_batch=1
            break
        fi
    done

    local cli_log="$AGY_CLI_DIR/cli.log"

    if [[ $is_batch -eq 1 ]]; then
        # ----------------------------------------------------------------------
        # Batch Mode: Auto-switch & retry through accounts automatically
        # ----------------------------------------------------------------------
        while [[ $attempt -le $max_attempts ]]; do
            local current_email
            current_email=$(get_current_email)
            echo -e "${BLUE}[GMA Auto-Switch] Menjalankan perintah dengan akun: ${GREEN}$current_email${NC} (Percobaan $attempt/$max_attempts)..."
            
            local tmp_out="$TMP_DIR/gma_run_$$.log"
            mkdir -p "$(dirname "$tmp_out")"
            
            local exit_code=0
            "$AGY_BIN" "$@" 2>&1 | tee "$tmp_out" || exit_code=$?

            # Inspect output for rate-limit / quota errors
            if [[ $exit_code -ne 0 ]] || grep -qiE "RESOURCE_EXHAUSTED|429|quota exceeded|quota_exceeded|rate limit|rate_limit|rate-limit|exhausted your quota|Individual quota reached" "$tmp_out"; then
                echo ""
                echo -e "${YELLOW}[GMA Auto-Switch] ⚠️ Kuota habis / Rate Limit terdeteksi pada: ${RED}$current_email${NC}"
                rm -f "$tmp_out"
                if [[ $attempt -lt $max_attempts ]]; then
                    echo -e "${CYAN}[GMA Auto-Switch] 🔄 Beralih ke akun berikutnya secara otomatis (tanpa perintah)...${NC}"
                    send_termux_notification "⚠️ GMA: Limit Kuota" "Auto-switch dari $current_email ke akun selanjutnya..." "high"
                    next_account >/dev/null
                    local next_email
                    next_email=$(get_current_email)
                    send_termux_notification "🔄 GMA: Akun Berganti" "Sekarang menggunakan: $next_email" "high"
                    attempt=$((attempt + 1))
                    echo ""
                    continue
                else
                    echo -e "${RED}[GMA Auto-Switch] ✗ Seluruh $total_accounts akun tersimpan telah dicoba atau mencapai limit kuota!${NC}"
                    send_termux_notification "🚨 GMA: Semua Kuota Habis" "Seluruh akun telah mencapai limit kuota Google." "high"
                    unset GMA_SWITCH_ATTEMPT
                    return $exit_code
                fi
            else
                rm -f "$tmp_out"
                unset GMA_SWITCH_ATTEMPT
                return $exit_code
            fi
        done
    else
        # ----------------------------------------------------------------------
        # Interactive Mode: Connected to TTY with background quota watcher
        # ----------------------------------------------------------------------
        local current_email
        current_email=$(get_current_email)
        echo -e "${BLUE}=== 🚀 ${APP_NAME} v${VERSION} - Mode Auto-Switch Aktif ===${NC}"
        echo -e "Akun Aktif : ${GREEN}${BOLD}$current_email${NC}"
        echo -e "Proteksi   : ${CYAN}Auto-Switch Kuota Otomatis (Tanpa Perintah)${NC}"
        echo ""

        local start_size=0
        if [[ -f "$cli_log" ]]; then
            start_size=$(wc -c < "$cli_log" 2>/dev/null || echo 0)
        fi

        local quota_flag="$TMP_DIR/gma_quota_flag_$$"
        mkdir -p "$(dirname "$quota_flag")"
        rm -f "$quota_flag"

        # Background log monitor: detects quota errors in real time
        # This breaks agy out of the futile 20-minute retry loop within 1.5s
        local watcher_pid=""
        (
            local last_s=$start_size
            while true; do
                sleep 1.2
                if [[ ! -f "$cli_log" ]]; then
                    continue
                fi
                local cur_s
                cur_s=$(wc -c < "$cli_log" 2>/dev/null || echo 0)
                if (( cur_s > last_s )); then
                    local chunk
                    chunk=$(tail -c +$((last_s + 1)) "$cli_log" 2>/dev/null || true)
                    last_s=$cur_s
                    if echo "$chunk" | grep -qiE "RESOURCE_EXHAUSTED|Individual quota reached|quota exceeded|code 429|exhausted your quota"; then
                        touch "$quota_flag"
                        # Terminate the agy process so it doesn't wait 20 minutes on retry backoff
                        local agy_pids
                        agy_pids=$(pgrep -P "$$" agy 2>/dev/null || true)
                        if [[ -n "$agy_pids" ]]; then
                            kill -TERM $agy_pids 2>/dev/null || true
                        fi
                        break
                    fi
                elif (( cur_s < last_s )); then
                    last_s=0
                fi
            done
        ) >/dev/null 2>&1 &
        watcher_pid=$!

        # Run agy with full terminal TTY attached
        local agy_exit=0
        "$AGY_BIN" "$@" || agy_exit=$?

        # Cleanup watcher
        kill "$watcher_pid" 2>/dev/null || true
        wait "$watcher_pid" 2>/dev/null || true

        # Check if quota limit was hit
        local quota_hit=0
        if [[ -f "$quota_flag" ]]; then
            quota_hit=1
            rm -f "$quota_flag"
        elif [[ $agy_exit -ne 0 && -f "$cli_log" ]]; then
            local final_size
            final_size=$(wc -c < "$cli_log" 2>/dev/null || echo 0)
            if (( final_size > start_size )); then
                local diff_log
                diff_log=$(tail -c +$((start_size + 1)) "$cli_log" 2>/dev/null || true)
                if echo "$diff_log" | grep -qiE "RESOURCE_EXHAUSTED|Individual quota reached|quota exceeded|code 429|exhausted your quota"; then
                    quota_hit=1
                fi
            fi
        fi

        if [[ $quota_hit -eq 1 ]]; then
            echo ""
            echo -e "${YELLOW}╔════════════════════════════════════════════════════════════╗${NC}"
            echo -e "${YELLOW}║         ⚠️  BATASAN KUOTA / RATE LIMIT TERDETEKSI!         ║${NC}"
            echo -e "${YELLOW}╚════════════════════════════════════════════════════════════╝${NC}"
            echo -e "Akun yang mencapai batas kuota: ${RED}${BOLD}$current_email${NC}"

            if [[ $attempt -ge $max_attempts ]]; then
                echo -e "${RED}[GMA Auto-Switch] ✗ Seluruh $total_accounts akun tersimpan telah mencapai batas kuota Google.${NC}"
                send_termux_notification "🚨 GMA: Semua Kuota Habis" "Seluruh akun tersimpan telah mencapai batas kuota Google." "high"
                unset GMA_SWITCH_ATTEMPT
                return 1
            fi

            echo -e "${CYAN}🔄 Mengalihkan akun aktif ke akun berikutnya secara otomatis (tanpa perintah)...${NC}"
            next_account >/dev/null
            local next_email
            next_email=$(get_current_email)

            send_termux_notification "🔄 GMA: Auto-Switch Akun" "Beralih ke: $next_email (Melanjutkan percakapan)" "high"
            echo -e "${GREEN}✓ Sekarang beralih ke: ${BOLD}$next_email${NC}"
            echo -e "${BLUE}▶ Melanjutkan percakapan secara otomatis (agy --continue)...${NC}"
            echo ""
            sleep 1

            export GMA_SWITCH_ATTEMPT=$((attempt + 1))

            # Determine continuation args: ensure --continue is present
            local has_cont=0
            for a in "$@"; do
                if [[ "$a" == "-c" || "$a" == "--continue" ]]; then
                    has_cont=1
                    break
                fi
            done

            if [[ $has_cont -eq 1 ]]; then
                exec "$GMA_BIN" run "$@"
            else
                exec "$GMA_BIN" run --continue "$@"
            fi
        fi

        unset GMA_SWITCH_ATTEMPT
        return $agy_exit
    fi
}

# ------------------------------------------------------------------------------
# Subcommand: daemon (Background Auto-Switch Monitor)
# ------------------------------------------------------------------------------
daemon_run() {
    local cli_log="$AGY_CLI_DIR/cli.log"
    mkdir -p "$TMP_DIR"
    
    echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] GMA Daemon v${VERSION} started (PID: $$)" >> "$DAEMON_LOG_FILE"

    local last_size=0
    local last_switch_time=0
    local current_inode=""

    if [[ -f "$cli_log" ]]; then
        last_size=$(wc -c < "$cli_log" 2>/dev/null || echo 0)
        current_inode=$(stat -c %i "$cli_log" 2>/dev/null || echo "")
    fi

    while true; do
        sleep 1.5

        if [[ ! -e "$cli_log" ]]; then
            continue
        fi

        # Detect log rotation (new inode or file shrank)
        local cur_inode
        cur_inode=$(stat -c %i "$cli_log" 2>/dev/null || echo "")
        local cur_size
        cur_size=$(wc -c < "$cli_log" 2>/dev/null || echo 0)

        if [[ "$cur_inode" != "$current_inode" ]] || (( cur_size < last_size )); then
            current_inode="$cur_inode"
            last_size=0
        fi

        if (( cur_size > last_size )); then
            local new_content
            new_content=$(tail -c +$((last_size + 1)) "$cli_log" 2>/dev/null || true)
            last_size=$cur_size

            if echo "$new_content" | grep -qiE "RESOURCE_EXHAUSTED|Individual quota reached|quota exceeded|code 429|exhausted your quota"; then
                local now_ts
                now_ts=$(date +%s)
                # Debounce: avoid duplicate switches within 6 seconds
                if (( now_ts - last_switch_time > 6 )); then
                    last_switch_time=$now_ts
                    local prev_email
                    prev_email=$(get_current_email)

                    echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] [ALERT] Limit kuota terdeteksi pada $prev_email. Auto-switching..." >> "$DAEMON_LOG_FILE"

                    next_account >/dev/null 2>&1 || true
                    local new_email
                    new_email=$(get_current_email)

                    echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] [SWITCH] Berhasil beralih dari $prev_email ke $new_email" >> "$DAEMON_LOG_FILE"

                    send_termux_notification "🔄 GMA Auto-Switch (Daemon)" "Kuota $prev_email habis. Otomatis beralih ke: $new_email" "high"

                    # If agy process is currently running and stuck in retry loop, interrupt it so it can restart cleanly
                    local agy_pids
                    agy_pids=$(pgrep -f "agy.*--.*|agy$" 2>/dev/null || true)
                    if [[ -n "$agy_pids" ]]; then
                        for ap in $agy_pids; do
                            if [[ "$ap" != "$$" ]]; then
                                kill -TERM "$ap" 2>/dev/null || true
                            fi
                        done
                    fi
                fi
            fi
        fi
    done
}

daemon_start() {
    local quiet="${1:-}"
    mkdir -p "$TMP_DIR"

    if [[ -f "$DAEMON_PID_FILE" ]]; then
        local pid
        pid=$(cat "$DAEMON_PID_FILE" 2>/dev/null || echo "")
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            [[ "$quiet" != "--quiet" ]] && echo -e "${YELLOW}GMA Daemon sudah berjalan (PID: ${pid}).${NC}"
            return 0
        fi
    fi

    if command -v setsid &>/dev/null; then
        setsid bash "$GMA_BIN" daemon run </dev/null >/dev/null 2>&1 &
    else
        nohup bash "$GMA_BIN" daemon run </dev/null >/dev/null 2>&1 &
    fi
    local new_pid=$!
    disown "$new_pid" 2>/dev/null || true
    echo "$new_pid" > "$DAEMON_PID_FILE"

    if [[ "$quiet" != "--quiet" ]]; then
        echo -e "${GREEN}✓ GMA Auto-Switch Daemon berhasil dijalankan di latar belakang! (PID: ${new_pid})${NC}"
        echo -e "Daemon akan terus memantau limit kuota secara otomatis tanpa perlu perintah manual."
    fi
}

daemon_stop() {
    if [[ -f "$DAEMON_PID_FILE" ]]; then
        local pid
        pid=$(cat "$DAEMON_PID_FILE" 2>/dev/null || echo "")
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null || true
            sleep 0.5
            kill -9 "$pid" 2>/dev/null || true
            rm -f "$DAEMON_PID_FILE"
            echo -e "${GREEN}✓ GMA Daemon (PID: ${pid}) berhasil dihentikan.${NC}"
            return 0
        fi
        rm -f "$DAEMON_PID_FILE"
    fi
    echo -e "${YELLOW}GMA Daemon tidak sedang berjalan.${NC}"
}

daemon_status() {
    echo -e "${BLUE}=== 🛡️ GMA Auto-Switch Daemon Status ===${NC}"

    local running=0
    local pid=""
    if [[ -f "$DAEMON_PID_FILE" ]]; then
        pid=$(cat "$DAEMON_PID_FILE" 2>/dev/null || echo "")
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            running=1
        fi
    fi

    if [[ $running -eq 1 ]]; then
        echo -e "Status         : ${GREEN}${BOLD}AKTIF (Berjalan di latar belakang)${NC}"
        echo -e "PID            : ${CYAN}${pid}${NC}"
        echo -e "Mode           : ${GREEN}Auto-Switch Penuh (Tanpa Perintah)${NC}"
    else
        echo -e "Status         : ${YELLOW}NONAKTIF (Tidak berjalan)${NC}"
        echo -e "Jalankan       : ${CYAN}gma daemon start${NC} untuk mengaktifkan pemantau latar belakang."
    fi

    if [[ -f "$DAEMON_LOG_FILE" ]]; then
        echo ""
        echo -e "${BLUE}Log Aktivitas Terakhir (5 baris terakhir):${NC}"
        tail -n 5 "$DAEMON_LOG_FILE" | sed 's/^/  /'
    fi
}

daemon_log() {
    if [[ -f "$DAEMON_LOG_FILE" ]]; then
        tail -n "${1:-30}" "$DAEMON_LOG_FILE"
    else
        echo -e "${YELLOW}Belum ada log daemon.${NC}"
    fi
}

# ------------------------------------------------------------------------------
# Subcommand: watch (Interactive Quota Log Watcher)
# ------------------------------------------------------------------------------
watch_log() {
    echo -e "${BLUE}=== 👁️ GMA Live Quota Watcher ===${NC}"
    echo -e "Memantau log Antigravity CLI secara real-time..."
    echo -e "Tekan ${CYAN}Ctrl+C${NC} untuk keluar.\n"
    
    local cli_log="$AGY_CLI_DIR/cli.log"
    if [[ ! -f "$cli_log" ]]; then
        echo -e "${YELLOW}Menunggu log Antigravity dibuat di $cli_log...${NC}"
        while [[ ! -f "$cli_log" ]]; do
            sleep 1
        done
    fi
    
    local last_size
    last_size=$(wc -c < "$cli_log" 2>/dev/null || echo 0)
    
    while true; do
        sleep 1
        local cur_size
        cur_size=$(wc -c < "$cli_log" 2>/dev/null || echo 0)
        if (( cur_size > last_size )); then
            local new_content
            new_content=$(tail -c +$((last_size + 1)) "$cli_log" 2>/dev/null || true)
            last_size=$cur_size
            
            if echo "$new_content" | grep -qiE "RESOURCE_EXHAUSTED|Individual quota reached|quota exceeded|code 429|exhausted your quota"; then
                local prev
                prev=$(get_current_email)
                echo -e "\n${RED}⚠️ [$(date +%H:%M:%S)] DETEKSI LIMIT KUOTA pada: $prev${NC}"
                echo -e "${CYAN}🔄 Beralih ke akun berikutnya secara otomatis...${NC}"
                next_account
                local nxt
                nxt=$(get_current_email)
                echo -e "${GREEN}✓ Akun aktif sekarang: $nxt${NC}\n"
            fi
        elif (( cur_size < last_size )); then
            last_size=0
        fi
    done
}

# ------------------------------------------------------------------------------
# Subcommand: hook (Antigravity Lifecycle Hooks Integration)
# ------------------------------------------------------------------------------
hook_stop_handler() {
    local payload
    payload=$(cat) # reads stdin JSON

    local is_quota=0
    if echo "$payload" | grep -qiE "RESOURCE_EXHAUSTED|Individual quota reached|quota exceeded|code 429|exhausted your quota"; then
        is_quota=1
    fi

    if [[ "$is_quota" -eq 1 ]]; then
        local prev_acc
        prev_acc=$(get_current_email)
        next_account >/dev/null 2>&1 || true
        local new_acc
        new_acc=$(get_current_email)
        send_termux_notification "🔄 GMA Auto-Switch (Hook)" "Kuota $prev_acc habis. Beralih ke $new_acc." "high"
        echo "{\"decision\":\"continue\",\"reason\":\"[GMA Auto-Switch] Kuota limit terdeteksi pada $prev_acc. Akun telah otomatis dialihkan ke $new_acc. Melanjutkan percakapan...\"}"
    else
        echo "{}"
    fi
}

setup_hooks() {
    mkdir -p "$CONFIG_DIR"
    local gma_path="$HOME_DIR/bin/gma"
    if [[ ! -x "$gma_path" ]]; then
        gma_path="$GMA_BIN"
    fi

    if command -v python3 &>/dev/null; then
        python3 -c "
import json, os

hooks_file = '$HOOKS_FILE'
gma_bin = '$gma_path'

data = {}
if os.path.exists(hooks_file):
    try:
        with open(hooks_file) as f:
            data = json.load(f)
    except Exception:
        data = {}

data['gma-autoswitch'] = {
    'enabled': True,
    'Stop': [
        {
            'type': 'command',
            'command': f'{gma_bin} hook stop',
            'timeout': 15
        }
    ]
}

with open(hooks_file, 'w') as f:
    json.dump(data, f, indent=2)
"
    else
        cat << EOF > "$HOOKS_FILE"
{
  "gma-autoswitch": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "$gma_path hook stop",
        "timeout": 15
      }
    ]
  }
}
EOF
    fi
    echo -e "${GREEN}✓ Antigravity Lifecycle Hook berhasil dipasang di $HOOKS_FILE${NC}"
}

# ------------------------------------------------------------------------------
# Subcommand: wrapper (Manage Transparent 'agy' Wrapper)
# ------------------------------------------------------------------------------
manage_wrapper() {
    local action="${1:-status}"
    local wrapper_target="$HOME_DIR/bin/agy"

    case "$action" in
        install)
            mkdir -p "$HOME_DIR/bin"
            cat << 'EOF' > "$wrapper_target"
#!/data/data/com.termux/files/usr/bin/bash
# ==============================================================================
# agy - Transparent Wrapper with Auto-Switch by GMA (Good Mode AGY)
# ==============================================================================
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GMA_BIN=""

if [[ -x "$SCRIPT_DIR/gma" ]]; then
    GMA_BIN="$SCRIPT_DIR/gma"
elif [[ -x "$HOME/bin/gma" ]]; then
    GMA_BIN="$HOME/bin/gma"
elif command -v gma >/dev/null 2>&1; then
    GMA_BIN="$(command -v gma)"
fi

if [[ -n "$GMA_BIN" && -x "$GMA_BIN" ]]; then
    exec "$GMA_BIN" run "$@"
fi

REAL_AGY="/data/data/com.termux/files/usr/bin/agy"
if [[ -x "$REAL_AGY" ]]; then
    exec "$REAL_AGY" "$@"
fi

echo "Error: Neither GMA nor real 'agy' binary found." >&2
exit 1
EOF
            chmod +x "$wrapper_target"
            echo -e "${GREEN}✓ Wrapper transparan 'agy' berhasil dipasang ke: ${BOLD}$wrapper_target${NC}"
            echo -e "Sekarang cukup ketik ${CYAN}agy${NC} seperti biasa, GMA akan otomatis menangani auto-switch kuota tanpa perintah!"
            ;;
        uninstall|remove)
            if [[ -f "$wrapper_target" ]]; then
                rm -f "$wrapper_target"
                echo -e "${GREEN}✓ Wrapper $wrapper_target berhasil dicopot.${NC}"
            else
                echo -e "${YELLOW}Wrapper $wrapper_target tidak ditemukan.${NC}"
            fi
            ;;
        status|*)
            echo -e "${BLUE}=== ⚡ Status Transparent Wrapper 'agy' ===${NC}"
            if [[ -f "$wrapper_target" && -x "$wrapper_target" ]]; then
                echo -e "Status       : ${GREEN}${BOLD}TERPASANG${NC} ($wrapper_target)"
                echo -e "Efek         : Mengetik ${CYAN}agy${NC} akan otomatis mengaktifkan auto-switch kuota."
            else
                echo -e "Status       : ${YELLOW}BELUM TERPASANG${NC}"
                echo -e "Pasang dengan: ${CYAN}gma wrapper install${NC}"
            fi
            ;;
    esac
}

# ------------------------------------------------------------------------------
# Command: export (Backup profiles to tar.gz)
# ------------------------------------------------------------------------------
export_accounts() {
    local default_filename="gma-accounts-backup-$(date +%Y%m%d_%H%M%S).tar.gz"
    local output_path="${1:-$HOME_DIR/$default_filename}"

    if [[ ! -d "$ACCOUNTS_DIR" ]] || [[ -z "$(ls -A "$ACCOUNTS_DIR" 2>/dev/null)" ]]; then
        echo -e "${RED}Error: Tidak ada profil akun tersimpan di $ACCOUNTS_DIR untuk diekspor.${NC}"
        exit 1
    fi

    # Backup current session state first so latest tokens are included
    backup_current

    echo -e "${BLUE}Mengekspor akun ke: ${BOLD}$output_path${NC}..."
    tar -czf "$output_path" -C "$GEMINI_DIR" accounts
    chmod 600 "$output_path"

    local size
    size=$(du -h "$output_path" | cut -f1)
    echo -e "${GREEN}✓ Berhasil diekspor! Ukuran file: $size${NC}"
    echo -e "Simpan file backup ini di tempat yang aman."
    send_termux_notification "📦 GMA: Backup Berhasil" "Arsip tersimpan di $output_path" "default"
}

# ------------------------------------------------------------------------------
# Command: import (Restore profiles from tar.gz)
# ------------------------------------------------------------------------------
import_accounts() {
    local backup_file="${1:-}"
    if [[ -z "$backup_file" ]]; then
        echo -e "${RED}Error: Masukkan path file backup (.tar.gz).${NC}"
        echo -e "Contoh: ${CYAN}gma import ~/gma-accounts-backup.tar.gz${NC}"
        exit 1
    fi

    if [[ ! -f "$backup_file" ]]; then
        echo -e "${RED}Error: File backup '$backup_file' tidak ditemukan.${NC}"
        exit 1
    fi

    echo -e "${BLUE}Mengimpor profil akun dari: ${BOLD}$backup_file${NC}..."
    mkdir -p "$GEMINI_DIR"
    tar -xzf "$backup_file" -C "$GEMINI_DIR"
    chmod -R 700 "$ACCOUNTS_DIR"

    local count
    count=$(get_saved_accounts | wc -l)
    echo -e "${GREEN}✓ Berhasil mengimpor! Total $count akun siap digunakan.${NC}"
    echo -e "Gunakan ${CYAN}gma list${NC} untuk melihat daftar akun yang diimpor."
    send_termux_notification "📥 GMA: Restore Berhasil" "$count akun berhasil dipulihkan." "default"
}

# ------------------------------------------------------------------------------
# Command: menu (Interactive TUI for Termux)
# ------------------------------------------------------------------------------
interactive_menu() {
    while true; do
        clear || true
        local current
        current=$(get_current_email)
        local accounts=()
        while IFS= read -r line; do
            [[ -n "$line" ]] && accounts+=("$line")
        done < <(get_saved_accounts)

        local cur_str
        if [[ "$current" == "none" ]]; then
            cur_str="${YELLOW}Tidak ada${NC}"
        else
            local meta
            meta=$(get_account_meta "$current")
            local al
            al=$(echo "$meta" | cut -d'|' -f1)
            local extra=""
            [[ -n "$al" ]] && extra=" ${MAGENTA}[$al]${NC}"
            cur_str="${GREEN}${BOLD}$current${NC}${extra}"
        fi

        # Daemon status string
        local d_status="${YELLOW}Nonaktif${NC}"
        if [[ -f "$DAEMON_PID_FILE" ]]; then
            local dp
            dp=$(cat "$DAEMON_PID_FILE" 2>/dev/null || echo "")
            if [[ -n "$dp" ]] && kill -0 "$dp" 2>/dev/null; then
                d_status="${GREEN}Aktif (PID: $dp)${NC}"
            fi
        fi

        # Wrapper status string
        local w_status="${YELLOW}Belum Pasang${NC}"
        if [[ -x "$HOME_DIR/bin/agy" ]]; then
            w_status="${GREEN}Aktif di ~/bin/agy${NC}"
        fi

        echo -e "${BLUE}╔════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${BLUE}║            🚀 ${BOLD}${APP_NAME} v${VERSION}${NC}${BLUE}                  ║${NC}"
        echo -e "${BLUE}║      Multi-Account Manager & Auto-Switcher for Termux      ║${NC}"
        echo -e "${BLUE}╚════════════════════════════════════════════════════════════╝${NC}"
        echo -e " Akun Aktif   : $cur_str | Tersimpan: ${BOLD}${#accounts[@]}${NC} akun"
        echo -e " Auto-Switch  : ${GREEN}Aktif Penuh (Otomatis Tanpa Perintah)${NC}"
        echo -e " Daemon Watch : $d_status | Wrapper: $w_status"
        echo -e "------------------------------------------------------------"
        echo -e "  ${CYAN}1)${NC} 📋 Daftar Semua Akun Tersimpan (List)"
        echo -e "  ${CYAN}2)${NC} 🔄 Ganti Akun Aktif (Switch)"
        echo -e "  ${CYAN}3)${NC} ⏭️  Auto-Rotate ke Akun Berikutnya (Next)"
        echo -e "  ${CYAN}4)${NC} ⚙️  Konfigurasi Kustom Akun (Alias, Model, Auto-Rotate)"
        echo -e "  ${CYAN}5)${NC} ➕ Tambah Akun Baru (Add / Google Auth)"
        echo -e "  ${CYAN}6)${NC} 💾 Simpan Akun Aktif Saat Ini (Save)"
        echo -e "  ${CYAN}7)${NC} 📊 Cek Status & Token (Status / Quota)"
        echo -e "  ${CYAN}8)${NC} ⚡ Jalankan AGY Mode Auto-Switch Kuota (gma run)"
        echo -e "  ${CYAN}9)${NC} 🛡️ Kelola Auto-Switch Background Daemon"
        echo -e " ${CYAN}10)${NC} ⚡ Pasang / Cek Transparent Wrapper 'agy'"
        echo -e " ${CYAN}11)${NC} 👁️ Live Quota Watcher (Monitor Real-Time)"
        echo -e " ${CYAN}12)${NC} 🔔 Uji Coba Notifikasi Termux"
        echo -e " ${CYAN}13)${NC} 📦 Backup / Export Akun (.tar.gz)"
        echo -e " ${CYAN}14)${NC} 📥 Restore / Import Akun (.tar.gz)"
        echo -e " ${CYAN}15)${NC} 🗑️  Hapus Akun Tersimpan (Remove)"
        echo -e "  ${CYAN}0)${NC} 🚪 Keluar"
        echo -e "------------------------------------------------------------"
        echo -n "Pilih menu [0-15]: "
        read -r choice

        case "$choice" in
            1)
                echo ""
                list_accounts
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            2)
                echo ""
                list_accounts
                echo ""
                echo -n "Masukkan nomor urut, email, atau alias yang ingin diaktifkan: "
                read -r target
                if [[ -n "$target" ]]; then
                    switch_account "$target"
                fi
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            3)
                echo ""
                next_account
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            4)
                echo ""
                config_account ""
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            5)
                echo ""
                add_account
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            6)
                echo ""
                save_account
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            7)
                echo ""
                status_account
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            8)
                echo ""
                echo -n "Masukkan prompt atau argumen untuk agy (kosongkan untuk interaktif): "
                read -r user_prompt
                if [[ -n "$user_prompt" ]]; then
                    run_with_autoswitch --print "$user_prompt"
                else
                    run_with_autoswitch
                fi
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            9)
                echo ""
                echo -e "${BLUE}=== 🛡️ Pengaturan Auto-Switch Background Daemon ===${NC}"
                daemon_status
                echo ""
                echo "1) Jalankan Daemon (Start)"
                echo "2) Hentikan Daemon (Stop)"
                echo "3) Lihat Log Aktivitas Daemon"
                echo "0) Kembali"
                echo -n "Pilihan [0-3]: "
                read -r d_opt
                case "$d_opt" in
                    1) daemon_start ;;
                    2) daemon_stop ;;
                    3) echo ""; daemon_log 20 ;;
                    *) ;;
                esac
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            10)
                echo ""
                manage_wrapper status
                echo ""
                echo "1) Pasang Wrapper ke ~/bin/agy"
                echo "2) Copot Wrapper dari ~/bin/agy"
                echo "0) Kembali"
                echo -n "Pilihan [0-2]: "
                read -r w_opt
                case "$w_opt" in
                    1) manage_wrapper install ;;
                    2) manage_wrapper uninstall ;;
                    *) ;;
                esac
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            11)
                echo ""
                watch_log
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            12)
                echo ""
                test_notification
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            13)
                echo ""
                echo -n "Path penyimpanan backup (kosongkan untuk default di ~/): "
                read -r dest
                export_accounts "$dest"
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            14)
                echo ""
                echo -n "Masukkan path file backup (.tar.gz): "
                read -r src
                import_accounts "$src"
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            15)
                echo ""
                list_accounts
                echo ""
                echo -n "Masukkan nomor urut, email, atau alias yang ingin dihapus: "
                read -r del_target
                if [[ -n "$del_target" ]]; then
                    remove_account "$del_target"
                fi
                echo ""
                read -r -p "Tekan [Enter] untuk kembali..." _
                ;;
            0|q|Q)
                echo -e "\n${GREEN}Terima kasih telah menggunakan ${APP_NAME}!${NC}"
                exit 0
                ;;
            *)
                echo -e "${RED}Pilihan tidak valid.${NC}"
                sleep 1
                ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# Help Text
# ------------------------------------------------------------------------------
show_help() {
    echo -e "${BLUE}=== 🚀 ${APP_NAME} v${VERSION} ===${NC}"
    echo -e "Multi-Account Manager, True Auto-Switcher & Enhancer untuk Google Antigravity CLI di Termux"
    echo ""
    echo -e "${BOLD}Penggunaan:${NC}"
    echo -e "  ${CYAN}gma${NC} [command] [options]"
    echo ""
    echo -e "${BOLD}Perintah Utama:${NC}"
    echo -e "  ${GREEN}menu${NC}                     Buka menu interaktif TUI (default jika tanpa argumen)"
    echo -e "  ${GREEN}run${NC}, ${GREEN}exec${NC} <argumen...>     Jalankan agy dengan auto-switch otomatis tanpa konfirmasi perintah"
    echo -e "  ${GREEN}daemon${NC} <start|stop|status|log>  Kelola background daemon untuk pemantauan limit kuota real-time"
    echo -e "  ${GREEN}wrapper${NC} <install|uninstall|status>  Pasang transparent wrapper ~/bin/agy (ketik 'agy' langsung auto-switch)"
    echo -e "  ${GREEN}watch${NC}                    Pantau log Antigravity secara langsung di terminal"
    echo -e "  ${GREEN}list${NC}, ${GREEN}ls${NC}                 Tampilkan semua akun tersimpan beserta alias & model"
    echo -e "  ${GREEN}current${NC}, ${GREEN}whoami${NC}           Tampilkan akun yang sedang aktif"
    echo -e "  ${GREEN}switch${NC} <id|alias|email>  Ganti akun aktif berdasarkan nomor, alias, atau email"
    echo -e "  ${GREEN}next${NC}, ${GREEN}rotate${NC}              Auto-rotate ke akun berikutnya secara manual"
    echo -e "  ${GREEN}config${NC}, ${GREEN}set${NC} <id|email>     Atur konfigurasi kustom (alias, default model, auto-rotate)"
    echo -e "  ${GREEN}add${NC}                      Tambah akun baru (via proses autentikasi Google)"
    echo -e "  ${GREEN}save${NC}                     Simpan akun aktif saat ini ke profil"
    echo -e "  ${GREEN}remove${NC}, ${GREEN}rm${NC} <target>       Hapus akun tersimpan"
    echo -e "  ${GREEN}status${NC}, ${GREEN}quota${NC} [--ping]   Cek masa berlaku token, status daemon, wrapper, & ping API"
    echo -e "  ${GREEN}test-notif${NC}               Uji coba notifikasi status bar Termux"
    echo -e "  ${GREEN}setup-hooks${NC}              Pasang konfigurasi native Lifecycle Hook Antigravity"
    echo -e "  ${GREEN}export${NC} [file.tar.gz]     Backup semua profil akun ke file terkompresi"
    echo -e "  ${GREEN}import${NC} <file.tar.gz>     Restore profil akun dari file backup"
    echo -e "  ${GREEN}raw${NC} <argumen...>         Jalankan agy asli secara langsung tanpa intervensi GMA"
    echo -e "  ${GREEN}version${NC}, ${GREEN}-v${NC}               Tampilkan versi GMA"
    echo -e "  ${GREEN}help${NC}, ${GREEN}-h${NC}                  Tampilkan panduan bantuan ini"
    echo ""
    echo -e "${BOLD}Opsi Global:${NC}"
    echo -e "  ${YELLOW}--no-color${NC}               Nonaktifkan warna ANSI"
    echo ""
    echo -e "${BOLD}Contoh Auto-Switch Tanpa Perintah:${NC}"
    echo -e "  gma wrapper install                  # Pasang wrapper: cukup ketik 'agy', auto-switch langsung aktif"
    echo -e "  gma daemon start                     # Aktifkan daemon pemantau kuota di latar belakang"
    echo -e "  agy                                  # Sesi agy biasa; saat kuota habis, otomatis beralih akun & resume!"
    echo -e "  agy -p 'Buatkan skrip bash'          # Batch command; otomatis retry dengan akun lain jika limit"
}

# ------------------------------------------------------------------------------
# Command Router
# ------------------------------------------------------------------------------
cmd="${1:-menu}"
shift || true

case "$cmd" in
    menu|"") interactive_menu ;;
    list|ls) list_accounts ;;
    current|whoami) current_account ;;
    switch) switch_account "${1:-}" ;;
    next|rotate|auto-switch) next_account ;;
    config|set) config_account "${1:-}" "$@" ;;
    test-notif|notif) test_notification ;;
    add) add_account ;;
    save) save_account ;;
    remove|rm|delete) remove_account "${1:-}" ;;
    status|quota|check) status_account "${1:-}" ;;
    run|exec) run_with_autoswitch "$@" ;;
    raw) 
        REAL_AGY=$(get_agy_binary)
        exec "$REAL_AGY" "$@"
        ;;
    daemon)
        sub="${1:-status}"
        shift || true
        case "$sub" in
            start) daemon_start "$@" ;;
            stop) daemon_stop ;;
            status) daemon_status ;;
            log|logs) daemon_log "$@" ;;
            run) daemon_run ;;
            *) echo -e "${RED}Opsi daemon tidak valid: $sub (gunakan start|stop|status|log)${NC}"; exit 1 ;;
        esac
        ;;
    watch) watch_log ;;
    wrapper)
        sub="${1:-status}"
        shift || true
        manage_wrapper "$sub"
        ;;
    hook)
        sub="${1:-stop}"
        shift || true
        case "$sub" in
            stop) hook_stop_handler ;;
            *) echo "{}" ;;
        esac
        ;;
    setup-hooks|hooks-setup) setup_hooks ;;
    export|backup) export_accounts "${1:-}" ;;
    import|restore) import_accounts "${1:-}" ;;
    version|-v|--version) echo -e "${APP_NAME} v${VERSION} (Termux Edition)" ;;
    help|-h|--help) show_help ;;
    *) echo -e "${RED}Perintah tidak dikenal: $cmd${NC}\n"; show_help; exit 1 ;;
esac
