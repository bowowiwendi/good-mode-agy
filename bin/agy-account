#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

# ANSI Colors
if [[ "${1:-}" != "--no-color" && -t 1 ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    BLUE='\033[0;34m'
    NC='\033[0m'
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    NC=''
fi

# Flag processing
if [[ "${1:-}" == "--no-color" ]]; then
    shift
fi

# Base paths
HOME_DIR="${HOME:-/data/data/com.termux/files/home}"
GEMINI_DIR="$HOME_DIR/.gemini"
AGY_CLI_DIR="$GEMINI_DIR/antigravity-cli"
ACCOUNTS_DIR="$GEMINI_DIR/accounts"

# Target files
TOKEN_FILE="$AGY_CLI_DIR/antigravity-oauth-token"
CRED_FILE="$GEMINI_DIR/gemini-credentials.json"
GOOGLE_ACC_FILE="$GEMINI_DIR/google_accounts.json"
SETTINGS_FILE="$AGY_CLI_DIR/settings.json"

mkdir -p "$ACCOUNTS_DIR"

# Helper to decode JWT
decode_jwt() {
    local token="$1"
    # JWT has 3 parts separated by dots, we need the second part (payload)
    local payload=$(echo "$token" | cut -d'.' -f2)
    # Fix base64 padding
    local len=$((${#payload} % 4))
    if [ $len -eq 2 ]; then payload="${payload}=="; fi
    if [ $len -eq 3 ]; then payload="${payload}="; fi
    # Decode base64 and extract email using grep/sed
    echo "$payload" | base64 -d 2>/dev/null | grep -oP '"email"\s*:\s*"\K[^"]+' || echo "unknown"
}

# Helper to get email from current active token
get_current_email() {
    if [[ -f "$TOKEN_FILE" ]]; then
        if command -v python3 &>/dev/null; then
            local id_token=$(python3 -c "import json,sys; print(json.load(sys.stdin).get('id_token', ''))" < "$TOKEN_FILE" 2>/dev/null || true)
        else
            local id_token=$(grep -oP '"id_token"\s*:\s*"\K[^"]+' "$TOKEN_FILE" 2>/dev/null || true)
        fi
        
        if [[ -n "$id_token" ]]; then
            decode_jwt "$id_token"
        else
            echo "unknown"
        fi
    else
        echo "none"
    fi
}

sanitize_email() {
    echo "$1" | sed 's/[^a-zA-Z0-9.-]/_/g'
}

list_accounts() {
    local current=$(get_current_email)
    echo -e "${BLUE}=== Antigravity CLI Accounts ===${NC}"
    
    local accounts=()
    if [[ -d "$ACCOUNTS_DIR" ]]; then
        for dir in "$ACCOUNTS_DIR"/*; do
            if [[ -d "$dir" ]]; then
                local meta_email="unknown"
                if [[ -f "$dir/meta.json" ]]; then
                    if command -v python3 &>/dev/null; then
                        meta_email=$(python3 -c "import json,sys; print(json.load(sys.stdin).get('email', 'unknown'))" < "$dir/meta.json" 2>/dev/null || true)
                    else
                        meta_email=$(grep -oP '"email"\s*:\s*"\K[^"]+' "$dir/meta.json" 2>/dev/null || true)
                    fi
                fi
                accounts+=("$meta_email|$dir")
            fi
        done
    fi

    if [[ ${#accounts[@]} -eq 0 ]]; then
        echo "No saved accounts found."
    else
        local idx=1
        for acc in "${accounts[@]}"; do
            local email="${acc%%|*}"
            local marker="  "
            if [[ "$email" == "$current" && "$current" != "none" ]]; then
                marker="${GREEN}* ${NC}"
            fi
            echo -e "${marker}${idx}. ${email}"
            idx=$((idx + 1))
        done
    fi
    
    echo ""
    if [[ "$current" == "none" ]]; then
        echo -e "${YELLOW}No active account currently logged in.${NC}"
    elif [[ ! " ${accounts[@]} " =~ "$current" ]]; then
        echo -e "Current active: ${GREEN}$current${NC} (not saved in profiles, use 'agy-account save' to save it?)"
    fi
}

current_account() {
    local email=$(get_current_email)
    if [[ "$email" == "none" ]]; then
        echo -e "${YELLOW}No active account.${NC}"
    else
        echo -e "Active account: ${GREEN}$email${NC}"
    fi
}

backup_current() {
    local email=$(get_current_email)
    if [[ "$email" != "none" && "$email" != "unknown" ]]; then
        local safe_email=$(sanitize_email "$email")
        local prof_dir="$ACCOUNTS_DIR/$safe_email"
        mkdir -p "$prof_dir"
        
        [[ -f "$TOKEN_FILE" ]] && cp "$TOKEN_FILE" "$prof_dir/oauth-token"
        [[ -f "$CRED_FILE" ]] && cp "$CRED_FILE" "$prof_dir/credentials.json"
        [[ -f "$GOOGLE_ACC_FILE" ]] && cp "$GOOGLE_ACC_FILE" "$prof_dir/google_accounts.json"
        [[ -f "$SETTINGS_FILE" ]] && cp "$SETTINGS_FILE" "$prof_dir/settings.json"
        
        echo "{\"email\":\"$email\",\"added_at\":\"$(date -u +"%Y-%m-%dT%H:%M:%SZ")\"}" > "$prof_dir/meta.json"
    fi
}

add_account() {
    echo -e "${BLUE}=== Add New Account ===${NC}"
    echo -e "${YELLOW}This will trigger AGY authentication for a new account.${NC}"
    echo ""

    # Determine working AGY binary
    local AGY_BIN=""
    local candidates=()
    local sys_agy
    sys_agy=$(command -v agy 2>/dev/null || true)
    [[ -n "$sys_agy" ]] && candidates+=("$sys_agy")
    [[ -n "${PREFIX:-}" && -x "$PREFIX/bin/agy" ]] && candidates+=("$PREFIX/bin/agy")
    candidates+=(
        "/data/data/com.termux/files/usr/bin/agy"
        "$HOME/.local/bin/agy"
    )

    for candidate in "${candidates[@]}"; do
        if [[ -x "$candidate" ]]; then
            # Verify binary can actually be executed (not failing with missing glibc linker/deps)
            if "$candidate" --help >/dev/null 2>&1; then
                AGY_BIN="$candidate"
                break
            fi
        fi
    done

    if [[ -z "$AGY_BIN" ]]; then
        echo -e "${RED}Error: Working 'agy' binary not found. Cannot trigger authentication.${NC}"
        exit 1
    fi

    # Backup current active account first
    local current_email=$(get_current_email)
    if [[ "$current_email" != "none" && "$current_email" != "unknown" ]]; then
        echo -e "Saving current account (${GREEN}$current_email${NC}) before switching..."
        backup_current
        echo -e "${GREEN}Current account backed up.${NC}"
    fi

    # Prepare safe temporary directory in user space
    local tmp_backup="$GEMINI_DIR/tmp/agy_auth_$$"
    mkdir -p "$tmp_backup"

    # Move existing token/creds aside so AGY is forced to re-authenticate
    [[ -f "$TOKEN_FILE" ]] && mv "$TOKEN_FILE" "$tmp_backup/"
    [[ -f "$CRED_FILE" ]] && mv "$CRED_FILE" "$tmp_backup/"

    # Trap to restore token if user cancels with Ctrl+C
    cleanup_on_interrupt() {
        echo -e "\n${YELLOW}Operation cancelled. Restoring previous account state...${NC}"
        [[ -f "$tmp_backup/antigravity-oauth-token" && ! -f "$TOKEN_FILE" ]] && mv "$tmp_backup/antigravity-oauth-token" "$TOKEN_FILE"
        [[ -f "$tmp_backup/gemini-credentials.json" && ! -f "$CRED_FILE" ]] && mv "$tmp_backup/gemini-credentials.json" "$CRED_FILE"
        rm -rf "$tmp_backup"
        exit 130
    }
    trap cleanup_on_interrupt INT TERM

    echo ""
    echo -e "${BLUE}=== Starting AGY Authentication ===${NC}"
    echo -e "${YELLOW}1. Open the URL shown below in your browser.${NC}"
    echo -e "${YELLOW}2. Complete Google login.${NC}"
    echo -e "${YELLOW}3. If an authorization code is given, paste it here and press Enter.${NC}"
    echo ""

    # Run AGY in foreground with stdin connected to terminal for pasting code
    local agy_exit=0
    "$AGY_BIN" --print "." || agy_exit=$?

    # Verify if new token file was created
    if [[ ! -f "$TOKEN_FILE" ]]; then
        echo ""
        echo -e "${RED}Authentication failed, was cancelled, or timed out.${NC}"
        [[ -f "$tmp_backup/antigravity-oauth-token" ]] && mv "$tmp_backup/antigravity-oauth-token" "$TOKEN_FILE"
        [[ -f "$tmp_backup/gemini-credentials.json" ]] && mv "$tmp_backup/gemini-credentials.json" "$CRED_FILE"
        rm -rf "$tmp_backup"
        trap - INT TERM
        exit 1
    fi

    # Verify the new token
    local new_email
    new_email=$(get_current_email)
    if [[ "$new_email" == "none" || "$new_email" == "unknown" ]]; then
        echo -e "${RED}Failed to determine email from new login. Token may be malformed.${NC}"
        [[ -f "$tmp_backup/antigravity-oauth-token" ]] && mv "$tmp_backup/antigravity-oauth-token" "$TOKEN_FILE"
        [[ -f "$tmp_backup/gemini-credentials.json" ]] && mv "$tmp_backup/gemini-credentials.json" "$CRED_FILE"
        rm -rf "$tmp_backup"
        trap - INT TERM
        exit 1
    fi

    if [[ "$new_email" == "$current_email" ]]; then
        echo -e "${YELLOW}Warning: Logged in as the same account ($new_email). No new account added.${NC}"
        rm -rf "$tmp_backup"
        trap - INT TERM
        exit 0
    fi

    echo -e "${GREEN}✓ New login detected for: $new_email${NC}"
    backup_current
    echo -e "${GREEN}✓ New account saved successfully!${NC}"
    echo ""
    echo -e "Use ${BLUE}agy-account switch <email|index>${NC} to switch between accounts."
    
    trap - INT TERM
    rm -rf "$tmp_backup"
}

save_account() {
    backup_current
    echo -e "${GREEN}Current account saved.${NC}"
}

switch_account() {
    local target="$1"
    if [[ -z "$target" ]]; then
        echo -e "${RED}Please provide an email or index number to switch to.${NC}"
        exit 1
    fi

    # Find matching account
    local target_dir=""
    local target_email=""
    
    local idx=1
    for dir in "$ACCOUNTS_DIR"/*; do
        if [[ -d "$dir" ]]; then
            local meta_email="unknown"
            if [[ -f "$dir/meta.json" ]]; then
                if command -v python3 &>/dev/null; then
                    meta_email=$(python3 -c "import json,sys; print(json.load(sys.stdin).get('email', 'unknown'))" < "$dir/meta.json" 2>/dev/null || true)
                else
                    meta_email=$(grep -oP '"email"\s*:\s*"\K[^"]+' "$dir/meta.json" 2>/dev/null || true)
                fi
            fi
            
            if [[ "$target" == "$meta_email" || "$target" == "$idx" ]]; then
                target_dir="$dir"
                target_email="$meta_email"
                break
            fi
            idx=$((idx+1))
        fi
    done
    
    if [[ -z "$target_dir" ]]; then
        echo -e "${RED}Account '$target' not found.${NC}"
        exit 1
    fi
    
    echo -e "${BLUE}Switching to: $target_email...${NC}"
    
    # Backup current before switching
    backup_current
    
    # Copy new files
    mkdir -p "$(dirname "$TOKEN_FILE")"
    
    [[ -f "$target_dir/oauth-token" ]] && cp "$target_dir/oauth-token" "$TOKEN_FILE"
    if [[ -f "$target_dir/credentials.json" ]]; then
        cp "$target_dir/credentials.json" "$CRED_FILE"
    else
        rm -f "$CRED_FILE"
    fi
    [[ -f "$target_dir/settings.json" ]] && cp "$target_dir/settings.json" "$SETTINGS_FILE"
    
    # Update google_accounts.json
    if [[ -f "$target_dir/google_accounts.json" ]]; then
        cp "$target_dir/google_accounts.json" "$GOOGLE_ACC_FILE"
    else
        echo "{\"active\": null, \"old\": [\"$target_email\"]}" > "$GOOGLE_ACC_FILE"
    fi
    
    echo -e "${GREEN}Successfully switched to $target_email${NC}"
}

remove_account() {
    local target="$1"
    if [[ -z "$target" ]]; then
        echo -e "${RED}Please provide an email or index number to remove.${NC}"
        exit 1
    fi
    
    local target_dir=""
    local target_email=""
    
    local idx=1
    for dir in "$ACCOUNTS_DIR"/*; do
        if [[ -d "$dir" ]]; then
            local meta_email="unknown"
            if [[ -f "$dir/meta.json" ]]; then
                if command -v python3 &>/dev/null; then
                    meta_email=$(python3 -c "import json,sys; print(json.load(sys.stdin).get('email', 'unknown'))" < "$dir/meta.json" 2>/dev/null || true)
                else
                    meta_email=$(grep -oP '"email"\s*:\s*"\K[^"]+' "$dir/meta.json" 2>/dev/null || true)
                fi
            fi
            
            if [[ "$target" == "$meta_email" || "$target" == "$idx" ]]; then
                target_dir="$dir"
                target_email="$meta_email"
                break
            fi
            idx=$((idx+1))
        fi
    done
    
    if [[ -z "$target_dir" ]]; then
        echo -e "${RED}Account '$target' not found.${NC}"
        exit 1
    fi
    
    echo -e "${YELLOW}Are you sure you want to remove $target_email? (y/N)${NC}"
    read -r confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        local current_email=$(get_current_email)
        rm -rf "$target_dir"
        if [[ "$target_email" == "$current_email" ]]; then
            rm -f "$TOKEN_FILE" "$CRED_FILE"
            echo -e "${YELLOW}Active session cleared as removed account was active.${NC}"
        fi
        echo -e "${GREEN}Removed $target_email${NC}"
    else
        echo "Cancelled."
    fi
}

show_help() {
    echo -e "${BLUE}agy-account - Multi-account manager for Antigravity CLI${NC}"
    echo ""
    echo "Usage:"
    echo "  agy-account list             - List all saved accounts"
    echo "  agy-account add              - Add a new account (via agy auth wait)"
    echo "  agy-account save             - Save current active account to profiles"
    echo "  agy-account switch <id>      - Switch to an account (by email or index)"
    echo "  agy-account remove <id>      - Remove a saved account (by email or index)"
    echo "  agy-account current          - Show current active account"
    echo "  agy-account help             - Show this help message"
    echo ""
    echo "Global options:"
    echo "  --no-color                   - Disable colored output"
}

# Main command router
cmd="${1:-help}"
shift || true

case "$cmd" in
    list) list_accounts ;;
    add) add_account ;;
    save) save_account ;;
    switch) switch_account "${1:-}" ;;
    remove) remove_account "${1:-}" ;;
    current) current_account ;;
    help) show_help ;;
    *) echo -e "${RED}Unknown command: $cmd${NC}"; show_help; exit 1 ;;
esac
