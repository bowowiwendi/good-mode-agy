#!/data/data/com.termux/files/usr/bin/bash
# ==============================================================================
# agy-account - Backward-compatibility wrapper for GMA (Good Mode AGY)
# ==============================================================================
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -x "$SCRIPT_DIR/gma" ]]; then
    exec "$SCRIPT_DIR/gma" "$@"
elif command -v gma >/dev/null 2>&1; then
    exec gma "$@"
else
    echo "Error: 'gma' binary not found." >&2
    exit 1
fi
